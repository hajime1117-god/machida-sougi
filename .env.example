# 本番URL（sitemap / canonical / OGP に使用）。末尾スラッシュなし
SITE_URL=https://example.com

# Google Analytics 4 の測定ID（例: G-XXXXXXXXXX）。未設定なら gtag を読み込まない
PUBLIC_GA4_ID=

# Microsoft Clarity のプロジェクトID。未設定なら読み込まない
PUBLIC_CLARITY_ID=

# Google Search Console の HTML タグ検証コード（content 属性の値）。任意
PUBLIC_GSC_VERIFICATION=

# 問い合わせフォームの送信先（Formspree / Cloudflare Pages Functions など）。未設定ならテストモード（送信せず thanks ページへ遷移）
PUBLIC_FORM_ENDPOINT=

# 計測イベントを console に出力し、GA4 DebugView 用に debug_mode を付与する（true/false）
PUBLIC_ANALYTICS_DEBUG=false
