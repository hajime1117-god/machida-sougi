---
/** パンくず（表示 + BreadcrumbList JSON-LD） */
import { SITE } from '../config/site';
export interface Crumb { href: string; label: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const all: Crumb[] = [{ href: '/', label: 'ホーム' }, ...items];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(i < all.length - 1 ? { item: SITE.url + c.href } : {}),
  })),
};
---
<nav class="breadcrumb" aria-label="現在位置" data-region="breadcrumb">
  <ol>
    {all.map((c, i) => (
      <li>
        {i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style>
  .breadcrumb { font-size: var(--fs-xs); color: var(--c-ink-3); padding: 0.75rem 0 0; }
  .breadcrumb ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2em 0; }
  .breadcrumb li { margin: 0; }
  .breadcrumb li + li::before { content: '›'; margin: 0 0.5em; color: var(--c-line); }
  .breadcrumb a { color: var(--c-ink-2); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
</style>
