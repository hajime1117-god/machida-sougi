---
/**
 * 全ページ共通レイアウト
 * - title / description / canonical / OGP / JSON-LD(WebSite, Organization) / GSC verification
 * - ヘッダー・フッター・モバイル固定CTA・計測スクリプト
 */
import '../styles/global.css';
import { BRAND, SITE, ANALYTICS } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FixedCta from '../components/FixedCta.astro';

interface Props {
  title: string;
  description: string;
  /** ページ種別（計測パラメータ page_type） */
  pageType?: 'top' | 'plan' | 'cost' | 'local' | 'hall' | 'area' | 'flow' | 'subsidy' | 'faq' | 'column' | 'about' | 'contact' | 'other';
  /** canonical を明示したい場合（通常は自動） */
  canonical?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** 追加の JSON-LD（配列可） */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** 固定CTAの文言を変える */
  fixedCta?: { telText?: string; contactText?: string; contactHref?: string } | false;
  /** 記事の公開日・更新日（Article用） */
  datePublished?: string;
  dateModified?: string;
  /** LCP 画像のプリロード（imagesrcset / imagesizes / type） */
  preloadImage?: { srcset: string; sizes: string; type: string };
}
const {
  title,
  description,
  pageType = 'other',
  canonical,
  ogType = 'website',
  noindex = false,
  jsonLd,
  fixedCta = {},
  preloadImage,
} = Astro.props;

const path = Astro.url.pathname;
const canonicalUrl = canonical || SITE.url + path;
const fullTitle = path === '/' ? title : `${title}｜${BRAND.name}`;
const ogImage = `${SITE.url}/og.png`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: BRAND.name,
  alternateName: BRAND.reading,
  url: SITE.url + '/',
  logo: `${SITE.url}/icon.svg`,
  areaServed: { '@type': 'AdministrativeArea', name: '東京都町田市' },
  description: `${BRAND.name}は、東京都町田市の家族葬・一日葬・火葬式（直葬）に関する情報を提供するSEO/AIO検証用の架空サイトです。`,
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: BRAND.name,
  url: SITE.url + '/',
  inLanguage: 'ja',
  publisher: { '@id': `${SITE.url}/#organization` },
};
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalUrl,
  url: canonicalUrl,
  name: fullTitle,
  description,
  inLanguage: 'ja',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organization` },
  ...(Astro.props.datePublished ? { datePublished: Astro.props.datePublished } : {}),
  ...(Astro.props.dateModified ? { dateModified: Astro.props.dateModified } : {}),
};
const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const analyticsConfig = JSON.stringify({ ga4Id: ANALYTICS.ga4Id, clarityId: ANALYTICS.clarityId, debug: ANALYTICS.debug });
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#1f4e5c" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ANALYTICS.gscVerification && <meta name="google-site-verification" content={ANALYTICS.gscVerification} />}
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {preloadImage && <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type={preloadImage.type} fetchpriority="high" />}
    {ANALYTICS.ga4Id && <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />}
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />
    {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <script is:inline set:html={`window.__analyticsConfig=${analyticsConfig};`} />
  </head>
  <body data-page-type={pageType} class:list={[{ 'has-fixed-cta': fixedCta !== false }]}>
    <a href="#main" class="skip-link">本文へ移動</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {fixedCta !== false && <FixedCta {...fixedCta} />}
    <script src="../scripts/analytics.ts"></script>
  </body>
</html>
<style is:global>
  .skip-link { position: absolute; left: -999px; top: 0; z-index: 100; background: var(--c-primary); color: #fff; padding: 0.5em 1em; }
  .skip-link:focus { left: 8px; top: 8px; }
</style>
