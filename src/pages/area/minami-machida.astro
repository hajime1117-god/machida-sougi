  { id: 'chui', label: 'このエリアで葬儀をするときの注意点' },
  { id: 'faq', label: 'よくある質問' },
];
const related = [
  { href: '/area/', label: '町田市のエリア別 葬儀案内', note: '5エリアの一覧に戻る' },
  { href: '/halls/', label: '町田市の斎場・葬儀場', note: '市内の民営式場一覧' },
  { href: '/halls/crematorium/', label: '町田市の火葬場', note: '南多摩斎場と市外火葬場の料金比較' },
  { href: '/first-steps/', label: '亡くなってから最初にすること', note: '搬送・安置の手配の流れ' },
  { href: '/plans/kazokuso/', label: '家族葬の費用と式場', note: '町田市の家族葬プランと総額例' },
