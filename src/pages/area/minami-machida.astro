const title = '南町田・つくし野・すずかけ台の葬儀・家族葬｜鶴間・金森・小川の式場と火葬場';
const h1 = '南町田・つくし野・すずかけ台（鶴間・金森・小川・南つくし野）の葬儀・家族葬案内';
const description = '南町田グランベリーパーク駅・つくし野駅・すずかけ台駅周辺（鶴間・金森・小川）で葬儀を行う場合の式場・火葬場を案内します。南多摩斎場までは市内で最も遠く、横浜市北部斎場（市外50,000円）が距離的に近い点が特徴です。';
const toc = [
  { id: 'gaiyo', label: 'このエリアの概要' },
  { id: 'kasoba', label: 'このエリアから近い火葬場' },
  { id: 'shikijo', label: 'このエリアから使いやすい式場' },
  { id: 'hanso', label: '病院・施設で亡くなった場合の搬送' },
