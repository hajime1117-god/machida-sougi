const title = '成瀬・高ヶ坂の葬儀・家族葬｜成瀬台・南成瀬・西成瀬の式場と火葬場';
const h1 = '成瀬・高ヶ坂（成瀬台・南成瀬・西成瀬・成瀬が丘）の葬儀・家族葬案内';
const description = 'JR横浜線成瀬駅周辺（成瀬・成瀬台・南成瀬・西成瀬・成瀬が丘・高ヶ坂）で葬儀を行う場合の火葬場（横浜市北部斎場が至近・南多摩斎場は車30〜40分）、民営式場、なるせ駅前市民センターでの死亡届手続きをまとめます。';
const toc = [
  { id: 'gaiyo', label: 'このエリアの概要' },
  { id: 'kasoba', label: 'このエリアから近い火葬場' },
  { id: 'shikijo', label: 'このエリアから使いやすい式場' },
