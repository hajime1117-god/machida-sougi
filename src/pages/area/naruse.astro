];
const related = [
  { href: '/area/', label: 'エリア情報トップ', note: '町田市内5エリアの一覧' },
  { href: '/halls/', label: '町田市の斎場・葬儀場', note: '公営・民営・寺院の式場一覧' },
  { href: '/halls/crematorium/', label: '町田市の火葬場', note: '南多摩斎場と市外の代替火葬場の料金比較' },
  { href: '/first-steps/', label: '亡くなってから最初にすること', note: '病院・施設からの搬送と安置の流れ' },
  { href: '/plans/kazokuso/', label: '家族葬のプランと費用', note: '528,000円（税込・本サイト設定価格）〜' },
  { href: '/contact/', label: 'お問い合わせ', note: '搬送のみのご依頼も可' },
];
const faqs = [
  { q: '成瀬・南成瀬から南多摩斎場までどのくらいかかりますか？', a: '<p>成瀬駅から南多摩斎場までは直線約10.5kmで、車ではおおむね30〜40分程度が目安です（公共交通機関の乗り継ぎを含めるとさらに時間がかかります）。町田市内では南部にあたるため、南多摩斎場までの距離は市内で比較的長いエリアの一つです。町田市民は南多摩斎場の火葬料が無料のため、費用を優先するか、距離的に近い横浜市北部斎場（市外料金）を選ぶかは、日程と費用のどちらを優先するかで判断することになります。</p>' },
  { q: '横浜市北部斎場は町田市民でも使えますか？', a: '<p>使えますが、死亡時に町田市に住民登録があった方は横浜市外の扱いになり、火葬料は10歳以上で50,000円（2026-09-15時点の公式料金）です。加えて市外の場合、火葬のみの予約は火葬日の3日前から、ホール利用は通夜日の2日前からしか申し込めません（横浜市民は火葬10日前・ホール9日前から予約可）。日程に余裕がない場合は、この予約開始日の違いに注意が必要です。</p>' },
  { q: '成瀬が丘・高ヶ坂にも南多摩斎場のような公営の式場はありますか？', a: '<p>いいえ、成瀬・高ヶ坂エリアに公営の葬儀式場はありません。公営で使える式場は南多摩斎場（町田市上小山田町、車で30〜40分程度）の第一〜第三式場に限られます。市民センターや自治会館を葬儀に利用できるかは町田市の公式ページで確認できず、当サイトでは断定していません。エリア内で使える式場は本文の民営式場の表を参照してください。</p>' },
];
---
<ArticleLayout {title} {h1} {description} {toc} {related} pageType="area" lastReviewed=""
  lead="成瀬駅周辺（成瀬・成瀬台・南成瀬・西成瀬・成瀬が丘）と高ヶ坂は、JR横浜線沿いの住宅地で、町田市の南東部にあたります。町田市民の火葬料が無料になる南多摩斎場までは距離があり、代わりに横浜市北部斎場が地理的に近いという、市内でも特有の事情があるエリアです。式場・搬送・手続き窓口を、このエリアの条件に合わせて説明します。"
  crumbs={[{ href: '/area/', label: 'エリア情報' }, { href: '/area/naruse/', label: '成瀬・高ヶ坂' }]}
  bottomCtaPosition="hall" bottomCtaTitle="成瀬・高ヶ坂エリアでのご相談" bottomCtaLead="搬送先の病院・施設名と、火葬場を距離優先にするか無料の南多摩斎場にするかをお伝えいただければ、日程と総額の目安をその場でご案内します。搬送のみのご依頼も受け付けています。">

  <h2 id="gaiyo">成瀬・高ヶ坂エリアの概要は？</h2>
  <div class="answer"><p>成瀬・高ヶ坂エリアは<strong>JR横浜線 成瀬駅を中心とした、成瀬・成瀬台・南成瀬・西成瀬・成瀬が丘・高ヶ坂</strong>を含む町田市南東部の住宅地です。町田市の公式な地域区分では「南地区」に属し、横浜市緑区・青葉区に近接しています。</p></div>
  <p>成瀬駅周辺は戸建てと集合住宅が混在する住宅地で、駅から半径3km圏にサービス付き高齢者向け住宅や介護施設が多いとされています（民間掲載サイトの件数情報で、町田市の公式統計ではないため参考情報扱いです）。南町田グランベリーパーク駅方面（鶴間・南町田）とは生活圏が近く、南多摩斎場や町田警察署など広域の行政・火葬場の情報は共通しています。</p>
  <p>町田市地域福祉計画の10地区区分では、成瀬・成瀬台・南成瀬・西成瀬・成瀬が丘・高ヶ坂は「南地区」に含まれ、金森・鶴間・南町田・小川・つくし野なども同じ南地区です。駅・生活圏で見ると、成瀬駅はJR横浜線の単独駅で、小田急線やほかの東急沿線駅とは接続していないため、町田駅方面や南町田方面へはバスまたは横浜線での乗り換えが基本になります。</p>
  <Source items={[{ label: 'みんかい 成瀬駅（周辺施設の民間掲載情報）', href: 'https://minkai.jp/tokyo/station4153/type334' }, { label: '町田市10地区の状況（町田市地域福祉計画）', href: 'https://www.city.machida.tokyo.jp/iryo/tiikihukusihoka/chiikifukushi/hukusikeikaku/keika.files/10tikunozyoukyou.pdf' }]} />

  <h2 id="kasoba">成瀬・高ヶ坂から近い火葬場はどこですか？</h2>
  <div class="answer"><p>成瀬駅から直線距離で最も近いのは<strong>横浜市北部斎場（約3.0km、車で約20分）</strong>ですが、町田市民は市外料金（10歳以上50,000円）がかかります。町田市民の火葬料が無料になる<strong>南多摩斎場は直線約10.5km、車で30〜40分程度</strong>が目安で、市内では南多摩斎場までの距離が長いエリアの一つです。</p></div>
  <p>相模原市営斎場も直線約4.5kmと横浜市北部斎場に次いで近い候補ですが、こちらも町田市民は市外料金（12歳以上54,000円）です。「無料だが遠い南多摩斎場」と「近いが数万円かかる市外の火葬場」のどちらを選ぶかは、火葬までの日程を急ぐかどうかで判断が分かれます。</p>
  <div class="table-wrap table-wrap--wide">
    <table>
      <caption>成瀬駅からの火葬場の目安（直線距離・車の所要時間はいずれも目安。料金は町田市民＝死亡時に町田市に住民登録がある場合。税表記なし＝公営の使用料は非課税。確認日2026-09-15）</caption>
      <thead><tr><th scope="col">火葬場</th><th scope="col">運営</th><th scope="col">成瀬駅からの距離・所要時間（目安）</th><th scope="col">火葬料（町田市民）</th></tr></thead>
      <tbody>
        <tr data-track-view="hall" data-item="横浜市北部斎場"><th scope="row">横浜市北部斎場</th><td>公営（横浜市）</td><td>直線約3.0km・車で約20分</td><td class="num">50,000円（10歳以上・市外料金）</td></tr>
        <tr data-track-view="hall" data-item="相模原市営斎場"><th scope="row">相模原市営斎場</th><td>公営（相模原市）</td><td>直線約4.5km</td><td class="num">54,000円（12歳以上・市外料金）</td></tr>
        <tr data-track-view="hall" data-item="南多摩斎場"><th scope="row">南多摩斎場</th><td>公営（南多摩斎場組合）</td><td>直線約10.5km・車で30〜40分程度</td><td class="num">無料（12歳以上・町田市民）</td></tr>
      </tbody>
    </table>
  </div>
  <Source items={[
    { label: '南多摩斎場 アクセス', href: 'https://www.minamitama-saijyo.jp/access/' },
    { label: '横浜市 市営斎場のご案内（料金）', href: 'https://www.city.yokohama.lg.jp/kurashi/sumai-kurashi/saijo/saijo/saijou.html' },
    { label: '相模原市営斎場 施設案内', href: 'https://www.city.sagamihara.kanagawa.jp/kurashi/shisetsu/shikanren/etc/1002725.html' },
    { label: '南多摩斎場 使用料', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' },
  ]} />
  <p>横浜市北部斎場は市外者の予約開始が遅く、火葬のみの予約は火葬日の3日前から、ホール利用は通夜日の2日前からしか申し込めません（横浜市民はそれぞれ10日前・9日前から予約可能）。年末年始は南多摩斎場が1月1日〜3日、横浜市北部斎場が1月1日・2日休場（いずれも2026年9月時点の公式情報）で、友引日も両施設とも休場することがあるため、日程を急ぐ場合は複数の火葬場の空き状況を合わせて確認することをすすめます。</p>
  <NextLink href="/halls/crematorium/" label="火葬場をくわしく" title="町田市の火葬場（南多摩斎場と市外の代替火葬場の料金・予約・混雑時の考え方）" />

  <h2 id="shikijo">成瀬・高ヶ坂で使いやすい式場はどこですか？</h2>
  <div class="answer"><p>成瀬エリアで公式サイトの所在地を確認できた民営式場は<strong>小さな家族葬ハウス町田成瀬（成瀬が丘1-30-1、株式会社永田屋）</strong>です。隣接する南町田エリアには<strong>小さなお葬式 南町田ホール（南町田3丁目、東急田園都市線南町田グランベリーパーク駅より徒歩9分）</strong>もあり、南多摩斎場までの移動を避けたい場合の選択肢になります。</p></div>
  <div class="table-wrap table-wrap--wide">
    <table>
      <caption>成瀬・高ヶ坂エリアと隣接エリアで公式確認できた民営式場（2026-09-15確認。収容規模・最寄駅は各施設公式ページに記載がある範囲）</caption>
      <thead><tr><th scope="col">名称</th><th scope="col">所在地</th><th scope="col">最寄駅</th><th scope="col">運営会社</th><th scope="col">収容規模</th></tr></thead>
      <tbody>
        <tr data-track-view="hall" data-item="小さな家族葬ハウス町田成瀬"><th scope="row">小さな家族葬ハウス町田成瀬</th><td>東京都町田市成瀬が丘1-30-1</td><td>未確認</td><td>株式会社永田屋</td><td>未確認</td></tr>
        <tr data-track-view="hall" data-item="小さなお葬式 南町田ホール"><th scope="row">小さなお葬式 南町田ホール</th><td>東京都町田市南町田3丁目47-5（隣接エリア）</td><td>東急田園都市線「南町田グランベリーパーク駅」徒歩9分</td><td>株式会社ユニクエスト（小さなお葬式ブランド）</td><td>〜30名</td></tr>
      </tbody>
    </table>
  </div>
  <Source items={[
    { label: '小さな家族葬ハウス町田（株式会社永田屋）', href: 'https://www.e-nagataya.com/machida/' },
    { label: '小さなお葬式 南町田ホール', href: 'https://ceremonyhouse.info/tokyo/machida-shi/ceremonyhouse_minamimachida/' },
  ]} />
  <p>収容人数や設備の詳細は各施設の公式サイトで直接確認してください。「小さなお葬式」の運営会社名（株式会社ユニクエスト）は一般に知られたブランド運営元ですが、施設ページ自体には社名の明記が確認できていないため参考情報として扱っています。公営で使える式場は南多摩斎場の第一〜第三式場のみで、成瀬・高ヶ坂エリア内に公営式場はありません。町田市民センターや自治会館を葬儀に利用できるかどうかは、町田市の公式ページで葬儀目的での貸室案内が確認できないため、当サイトでは可否を断定していません。</p>
  <Cta position="hall" variant="inline" telText="式場について電話で相談" contactText="メールで相談" />
  <NextLink href="/halls/" label="町田市内の式場一覧" title="町田市の斎場・葬儀場（公営・民営・寺院）" />

  <h2 id="hanso">近くの病院・施設で亡くなった場合の搬送は？</h2>
  <div class="answer"><p>成瀬・高ヶ坂エリアに近い病院として公式に確認できているのは<strong>南町田病院（町田市鶴間、隣接する南地区）</strong>です。成瀬エリア周辺には高齢者向け住宅・介護施設が多いとされており、そこからの搬送依頼も想定されます。</p></div>
  <p>病院や施設で亡くなった場合、死亡診断書の発行後にご遺体を安置場所（ご自宅または安置施設）へ搬送します。搬送時間は交通状況によって変わるため「目安」として扱ってください。搬送だけを先に依頼し、葬儀社や式場は落ち着いてから決めることもできます。</p>
  <Source items={[{ label: '南町田病院', href: 'https://www.mmhp.jp/' }]} />
  <NextLink href="/first-steps/" label="亡くなってから最初にすること" title="病院・施設からの搬送、深夜の連絡、警察が関わるケースの整理" />

  <h2 id="todokede">死亡届・葬祭費の窓口はどこですか？</h2>
  <div class="answer"><p>成瀬・高ヶ坂エリアの死亡届は、市庁舎1階市民課戸籍係（104窓口）のほか、<strong>成瀬駅前にある「なるせ駅前市民センター」</strong>でも提出できます。国民健康保険・後期高齢者医療の葬祭費（各5万円）の申請も、なるせ駅前市民センターの窓口で受け付けています。</p></div>
  <p>死亡届は、死亡の事実を知った日を含めて7日以内に提出します。届出に伴って火葬許可証が交付され、受付時間内であれば即日発行されます。葬祭費の申請期限は、葬祭を行った日の翌日から2年です。窓口での手続きは当サイトが代行できます。</p>
  <Source items={[
    { label: '町田市 死亡届', href: 'https://www.city.machida.tokyo.jp/kurashi/touroku/todokede/todokede03.html' },
    { label: '町田市 国民健康保険 葬祭費', href: 'https://www.city.machida.tokyo.jp/kurashi/hoken/kokuho/ironnakyuufu/sousai.html' },
  ]} />
  <NextLink href="/subsidy/" label="葬祭費の申請方法" title="葬祭費・補助金の申請方法（国保・後期高齢・社保・葬祭扶助）" />

  <h2 id="chui">成瀬・高ヶ坂で葬儀をするときの注意点は？</h2>
  <div class="answer"><p>成瀬・高ヶ坂エリアで注意したいのは、<strong>①南多摩斎場までの距離が市内でも長いこと、②市外の横浜市北部斎場・相模原市営斎場は予約開始日が遅いこと、③エリア内に公営式場がないこと</strong>の3点です。</p></div>
  <p>南多摩斎場までは車で30〜40分程度かかるため、参列者の移動時間や霊柩車の手配時間を通常より多めに見込む必要があります。無料の南多摩斎場を使うか、市外料金がかかっても近い横浜市北部斎場・相模原市営斎場を使うかは、火葬までの日程と参列者の移動負担のどちらを優先するかで判断します。市外の火葬場は町田市民にとって予約開始日が遅く設定されているため、日程を急ぐ場合ほど事前の空き状況確認が重要です。</p>
  <p>成瀬・高ヶ坂エリアには南多摩斎場のような公営式場がなく、式場は民営ホールや寺院の会館が中心になります。菩提寺がある場合は早めに連絡し、通夜・告別式の日程を相談してください。</p>
  <p>成瀬駅は横浜市緑区・青葉区に隣接しているため、「神奈川県内の公営斎場が使えるのでは」という疑問が生じやすいエリアでもあります。横浜市北部斎場は公営ですが町田市民は市外料金の対象で、川崎市・横浜市が運営するその他の公営斎場についても、非住民の受け入れ可否・料金は施設ごとに個別確認が必要です。当サイトでは公式に確認できた横浜市北部斎場以外の神奈川県内公営斎場について、断定的な案内はしていません。</p>

  <h2 id="faq">成瀬・高ヶ坂エリアの葬儀でよくある質問</h2>
  <Faq items={faqs} group="area-naruse" />
</ArticleLayout>
