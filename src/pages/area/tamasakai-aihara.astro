const title = '多摩境・相原・小山の葬儀・家族葬｜小山ヶ丘・相原町・小山田の式場と火葬場';
const h1 = '多摩境・相原・小山（小山ヶ丘・相原町・小山町・小山田）の葬儀・家族葬案内';
const description = '京王相模原線多摩境駅・JR横浜線相原駅周辺（小山ヶ丘・相原町・小山町・上小山田町・下小山田町）は南多摩斎場に最も近いエリアです。火葬場までの距離、式場、堺市民センター・小山市民センターでの死亡届手続きをまとめます。';
const toc = [
  { id: 'gaiyo', label: 'このエリアの概要' },
  { id: 'kasoba', label: 'このエリアから近い火葬場' },
  { id: 'shikijo', label: 'このエリアから使いやすい式場' },
  { id: 'hanso', label: '病院・施設からの搬送' },
