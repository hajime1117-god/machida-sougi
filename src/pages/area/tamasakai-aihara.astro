  { id: 'chui', label: 'このエリアで葬儀をするときの注意点' },
  { id: 'faq', label: 'よくある質問' },
];
const related = [
  { href: '/area/', label: 'エリア情報トップ', note: '町田市内5エリアの一覧' },
  { href: '/halls/', label: '町田市の斎場・葬儀場', note: '公営・民営・寺院の式場一覧' },
  { href: '/halls/crematorium/', label: '町田市の火葬場', note: '南多摩斎場と市外の代替火葬場の料金比較' },
  { href: '/first-steps/', label: '亡くなってから最初にすること', note: '病院・施設からの搬送と安置の流れ' },
  { href: '/plans/kazokuso/', label: '家族葬のプランと費用', note: '528,000円（税込・本サイト設定価格）〜' },
  { href: '/contact/', label: 'お問い合わせ', note: '搬送のみのご依頼も可' },
];
const faqs = [
  { q: '多摩境駅から南多摩斎場までどのくらいかかりますか？', a: '<p>南多摩斎場公式サイトのアクセスページには多摩境駅からの案内が掲載されておらず、公式には未確認です。直線距離は約1.9kmで、第三者の葬儀情報サイトでは車で4〜6分程度という記載がありますが、参考情報として扱ってください。町田市内では最も南多摩斎場に近いエリアで、橋本駅・南大沢駅経由のバス・タクシーも利用できます。</p>' },
  { q: '相原・多摩境エリアに公営の式場はありますか？', a: '<p>単独では公営式場はありませんが、南多摩斎場（上小山田町）に第一〜第三式場が併設されており、このエリアからは火葬場と式場を同じ場所で使えます。第二・第三式場は組合構成市（町田市を含む5市）住民で使用料50,000円、第一式場は140,000円です（2026-09-15確認）。エリア内に公式確認できた民営の家族葬ホールはありません。</p>' },
  { q: '相原町・小山町で亡くなった場合、警察はどこが担当ですか？', a: '<p>相原町・小山町・小山ヶ丘は町田警察署の管轄ではなく、八王子市の南大沢警察署の管轄です（2009年に管轄が移管されたとされています）。死因が明らかでない場合や事故死など警察の検視が必要なケースでは、連絡先が町田市の他エリアと異なる点に注意してください。</p>' },
