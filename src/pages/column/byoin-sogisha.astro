---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import NextLink from '../../components/NextLink.astro';
import Source from '../../components/Source.astro';
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../config/site';

const title = '病院で亡くなったら葬儀社はすぐ決める？';
const h1 = '病院で亡くなったら、葬儀社をすぐ決める必要はある？搬送だけ頼む方法';
const description = '病院で「葬儀社を決めてください」と言われても、搬送と安置だけを依頼し、葬儀は後から比較して決めて構いません。断り方と伝え方、安置先の選び方を説明します。';
const toc = [
  { id: 'chokugo', label: '亡くなった直後に起きること' },
  { id: 'sugu-kimenai', label: 'すぐ決めなくてよい理由' },
  { id: 'kotowaru', label: '病院紹介の葬儀社を断ってよいか' },
  { id: 'hansou-dake', label: '搬送だけを依頼する方法' },
  { id: 'anchisaki', label: '安置先の選び方' },
  { id: 'shinya', label: '深夜・早朝に亡くなった場合' },
  { id: 'machida-byoin', label: '町田市の病院からの搬送' },
  { id: 'faq', label: 'よくある質問' },
];
const related = [
  { href: '/first-steps/', label: '亡くなってから最初にすること', note: '病院・自宅など状況別の手順' },
  { href: '/flow/', label: '葬儀の流れ', note: '死亡届・火葬許可証までの手続き' },
  { href: '/plans/', label: '葬儀プラン比較', note: '家族葬・一日葬・火葬式の違い' },
  { href: '/plans/kasoshiki/', label: '火葬式・直葬', note: '式を行わず火葬のみで見送る場合' },
  { href: '/contact/', label: 'お問い合わせ・事前相談', note: '搬送のみのご相談も受け付けます' },
];
const faqs = [
  { q: '搬送だけ頼んで、葬儀は別の葬儀社に依頼してもよいですか？', a: '<p>問題ありません。搬送・安置と、通夜・告別式を行う葬儀の依頼は別の契約です。搬送を担当した葬儀社にそのまま葬儀まで依頼する義務はなく、安置している間に複数社から見積もりを取って比較しても構いません。</p>' },
  { q: '病院から紹介された葬儀社を断ると、その場で何か不利益がありますか？', a: '<p>ありません。病院は死亡診断書の発行とご遺体の引き渡しの手続きを行うだけで、葬儀社の契約には関与しません。「他を検討します」「搬送のみお願いします」と伝えれば、病院側の対応が変わることはありません。</p>' },
  { q: '搬送だけの料金はいくらですか？', a: '<p>搬送距離（病院から安置先までの距離）と、安置する日数によって変わるため、一律の金額はお伝えできません。距離と安置日数の見込みをお伝えいただければ、その場でお見積もりします。</p>' },
  { q: '安置する場所が決まっていなくても搬送を頼めますか？', a: '<p>頼めます。電話の時点で自宅に安置できるかどうか（部屋の広さ、集合住宅の搬入経路、ご近所への配慮など）を伝えていただければ、安置施設を使うべきか含めて搬送前にご案内します。</p>' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  datePublished: '2026-09-16',
  dateModified: '2026-09-16',
  inLanguage: 'ja',
  author: { '@type': 'Organization', name: '町田ことのは葬祭 編集部' },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: `${SITE.url}/column/byoin-sogisha/`,
};
---
<ArticleLayout {title} {h1} {description} {toc} {related} pageType="column" lastReviewed=""
  ogType="article" datePublished="2026-09-16" dateModified="2026-09-16" {jsonLd}
  lead="病院で「葬儀社は決まっていますか」と聞かれると、その場で決めなければならないと思いがちですが、病院に留め置ける時間は数時間ほどで、まず必要なのは搬送先の確保です。搬送と葬儀の依頼は分けて考えてよく、葬儀社は安置後に比較して決めても構いません。"
  crumbs={[{ href: '/column/', label: '葬儀コラム' }, { href: '/column/byoin-sogisha/', label: '病院で亡くなったら' }]}
  bottomCtaPosition="middle" bottomCtaTitle="搬送のみのご相談も受け付けます" bottomCtaLead="病院名と安置を希望する場所（ご自宅か施設か）をお伝えいただければ、搬送の可否と到着までの目安をお答えします。葬儀のご依頼は必須ではありません。">

  <h2 id="chokugo">病院で亡くなった直後に起きることは？</h2>
  <div class="answer"><p>病院で亡くなると、医師が<strong>死亡診断書</strong>を作成し、看護師が<strong>エンゼルケア</strong>（ご遺体の清拭・処置）を行った後、ご遺体は病室から霊安室に移されます。霊安室に置ける時間は数時間程度が一般的とされ、その間に搬送先を決めて葬儀社を手配する必要があります。</p></div>
  <p>死亡診断書は、後の死亡届の提出や火葬許可証の取得に必要な書類のため、原本を必ず受け取って保管します。エンゼルケアの間、ご家族は死亡診断書の受け取りや連絡すべき親族への連絡、そして搬送先（安置場所）の検討にあてる時間になります。病院の霊安室は長時間の安置を想定した設備ではないため、数時間のうちに寝台車で運び出すのが通常の流れです。</p>

  <h2 id="sugu-kimenai">葬儀社を「すぐ決める」必要はない理由</h2>
  <div class="answer"><p>病院で急いで決めるべきなのは<strong>搬送先（安置場所）と、そこまで運ぶ寝台車の手配</strong>だけです。通夜・告別式をどの葬儀社に依頼するかは、安置してから落ち着いて比較しても遅くありません。搬送と葬儀は別の依頼として分けられます。</p></div>
  <p>病院のスタッフが急かすように見えるのは、霊安室を長時間占有できないという病院側の事情によるもので、葬儀社選びを急がせる意図ではありません。搬送だけを先に依頼し、安置した後に複数の葬儀社から見積もりを取って比較する進め方は一般的です。当サイトでも、搬送のみのご依頼を受け付けており、その後の葬儀を他社に依頼されても構いません。</p>
  <NextLink href="/first-steps/" label="全体の手順を先に確認する" title="亡くなってから最初にすること（病院・自宅など状況別）" />

  <h2 id="kotowaru">病院が紹介する葬儀社を断ってもよいか</h2>
  <div class="answer"><p>断って構いません。病院が紹介する葬儀社（多くは病院と提携する特定の業者）に搬送や葬儀を依頼する<strong>義務はなく</strong>、断ったことで治療や手続きの対応が変わることもありません。</p></div>
  <p>「紹介された葬儀社に頼まないと霊安室から出られない」ということはなく、ご家族が事前に決めていた葬儀社や、これから探す葬儀社に連絡して搬送を依頼できます。病院から紹介を受けた場合は、その場で契約書に署名せず、「一度家族で相談します」「他の葬儀社に依頼します」と伝えれば十分です。搬送だけを他社に依頼し、葬儀の契約はしない、という進め方もできます。</p>

  <h2 id="hansou-dake">搬送だけを依頼する方法と伝え方</h2>
  <div class="answer"><p>搬送のみを依頼する場合は、電話で<strong>①亡くなった病院名（所在地）、②安置を希望する場所、③連絡者の続柄と電話番号、④葬儀は別途検討中であること</strong>を伝えます。この4点を伝えれば、寝台車の手配だけを進めてもらえます。</p></div>
  <p>電話をかける際に、次の内容を順番に伝えるとスムーズです。</p>
  <div class="table-wrap">
    <table>
      <caption>搬送のみを依頼する電話で伝える内容（チェックリスト）</caption>
      <thead><tr><th scope="col">順番</th><th scope="col">伝える内容</th></tr></thead>
      <tbody>
        <tr><th scope="row">1</th><td>亡くなった方の氏名、亡くなった病院名と所在地（病室・霊安室の場所が分かれば併せて）</td></tr>
        <tr><th scope="row">2</th><td>安置を希望する場所（自宅／安置施設／未定で相談したい）</td></tr>
        <tr><th scope="row">3</th><td>連絡している方の氏名・故人との続柄・当日連絡がつく電話番号</td></tr>
        <tr><th scope="row">4</th><td>「搬送のみを依頼したい。葬儀は別途検討する」と明確に伝える</td></tr>
        <tr><th scope="row">5</th><td>寝台車の到着見込み時刻を確認する</td></tr>
      </tbody>
    </table>
  </div>
  <p>「搬送のみ」と最初に伝えておくと、葬儀プランの説明を先に受けることなく、必要な手配だけを進めてもらいやすくなります。当サイトでは、この時点でのご連絡から搬送のみを承り、葬儀のご依頼をあらためて検討していただいて構いません。</p>
  <Cta position="middle" variant="inline" telText="搬送について電話で相談" contactText="メールで相談" />

  <h2 id="anchisaki">安置先の選び方</h2>
  <div class="answer"><p>安置先の候補は<strong>①ご自宅、②葬儀社の安置施設、③火葬場の霊安室</strong>の3つです。集合住宅で搬入経路が狭い場合や、ご近所への配慮を優先する場合は葬儀社の安置施設、火葬までの日程がすでに決まっている場合は火葬場の霊安室が選択肢になります。</p></div>
  <div class="table-wrap">
    <table>
      <caption>安置先の選択肢と特徴</caption>
      <thead><tr><th scope="col">安置先</th><th scope="col">特徴</th><th scope="col">向いているケース</th></tr></thead>
      <tbody>
        <tr><th scope="row">ご自宅</th><td>使用料はかからないが、部屋の広さ・エレベーターの有無・搬入経路の確認が必要</td><td>自宅で最後の時間を過ごしたい</td></tr>
        <tr><th scope="row">葬儀社の安置施設</th><td>ドライアイスの管理や面会の調整を任せられる。距離と日数に応じて料金がかかる</td><td>自宅への搬入が難しい、集合住宅で音や人の出入りに配慮したい</td></tr>
        <tr><th scope="row">火葬場の霊安室</th><td>南多摩斎場は組織市住民48時間まで3,000円。火葬の日程が近い場合に限られる</td><td>火葬までの日程が短く決まっている</td></tr>
      </tbody>
    </table>
  </div>
  <Source items={[{ label: '南多摩斎場 使用料（霊安室）', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' }]} />
  <p>安置日数がのびるほど、安置施設の使用料とドライアイス代が積み重なります。搬送を依頼する電話の時点で安置先の候補を決めきれていなくても構いませんが、集合住宅にお住まいの場合は搬入経路について事前に伝えておくと、当日の対応が早くなります。</p>
  <NextLink href="/plans/kasoshiki/" label="式を行わない場合の内容を見る" title="火葬式・直葬｜内容と町田市での火葬までの流れ" />

  <h2 id="shinya">深夜・早朝に亡くなった場合の流れ</h2>
  <div class="answer"><p>深夜・早朝でも搬送は<strong>24時間対応</strong>で依頼できます。搬送と安置は時間を問わず進められますが、死亡届の提出や火葬場の予約は町田市役所・市民センターや南多摩斎場の受付時間内（南多摩斎場の個人申込は8:30〜22:00）にあわせて翌朝以降に行うのが通常です。</p></div>
  <p>深夜に亡くなった場合、まずは搬送先（自宅か安置施設か）を電話で伝え、寝台車の到着を待ちます。葬儀社との詳しい打ち合わせは、安置が済んでから翌日以降にあらためて行う形で問題ありません。死亡届は亡くなったことを知った日を含めて7日以内に提出する決まりのため、深夜のうちに急いで役所へ向かう必要はありません。</p>
  <Source items={[{ label: '南多摩斎場 申込方法・受付時間', href: 'https://www.minamitama-saijyo.jp/guide/application.php' }, { label: '町田市 死亡届', href: 'https://www.city.machida.tokyo.jp/kurashi/touroku/todokede/todokede03.html' }]} />
  <NextLink href="/flow/" label="死亡届・手続きの流れを見る" title="葬儀の流れ（逝去から法要・手続きまで）" />

  <h2 id="machida-byoin">町田市の病院からの搬送</h2>
  <div class="answer"><p>町田市旭町の町田市民病院をはじめ、市内の病院からの搬送は、<strong>市内であれば搬送先まで30分〜1時間程度が目安</strong>です（道路状況や搬送先の距離により変わります）。搬送先が自宅か安置施設かにより、到着後の対応が異なります。</p></div>
  <p>搬送時間は病院から安置先までの実際の距離や道路状況によって前後するため、あくまで目安として捉えてください。市外の病院で亡くなった場合や、安置先を町田市内にする場合も搬送は依頼できます。搬送を依頼する際に病院名と安置先の候補地を伝えれば、おおよその到着見込みをその場で案内します。</p>

  <h2 id="faq">よくある質問</h2>
  <Faq items={faqs} group="column" />
</ArticleLayout>
