---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import NextLink from '../../components/NextLink.astro';
import Source from '../../components/Source.astro';
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../config/site';

const title = '一日葬と家族葬、どちらを選ぶ？費用差と目安';
const h1 = '一日葬と家族葬、どちらを選ぶ？判断の目安と町田市での費用差';
const description = '通夜を省く一日葬（396,000円〜）と、通夜・告別式を2日間行う家族葬（528,000円〜）の違いを、参列者の年齢・菩提寺の意向・費用差など5つの判断基準とケース別の目安で説明します。';
const toc = [
  { id: 'chigai', label: '一日葬と家族葬の違い' },
  { id: 'kijun', label: '判断基準5つ' },
  { id: 'case', label: 'ケース別の目安' },
  { id: 'machida', label: '町田市での事情' },
  { id: 'kimekata', label: '迷ったときの決め方' },
  { id: 'faq', label: 'よくある質問' },
];
const related = [
  { href: '/plans/ichinichiso/', label: '一日葬', note: '費用・当日の流れ・注意点' },
  { href: '/plans/kazokuso/', label: '家族葬', note: '費用・2日間の流れ・注意点' },
  { href: '/plans/', label: '葬儀プラン比較', note: '家族葬・一日葬・火葬式の違い' },
  { href: '/cost/', label: '葬儀費用の内訳と総額例', note: '追加になりやすい費用と抑え方' },
  { href: '/halls/', label: '町田市の斎場・葬儀場', note: '南多摩斎場と民営式場' },
  { href: '/contact/', label: 'お問い合わせ・事前相談', note: '人数と菩提寺の有無を伝えて相談' },
];
const faqs = [
  { q: '一日葬は家族葬より格上・格下ということはありますか？', a: '<p>ありません。一日葬と家族葬は「通夜をするかしないか」という形式の違いで、優劣はありません。参列者の負担や費用、菩提寺の意向に合わせて選ぶものです。</p>' },
  { q: '一度、家族葬で式場を予約した後に一日葬へ変更できますか？', a: '<p>火葬の予約前であれば変更できることが多いですが、式場・料理・返礼品の手配が進んでいると変更できない場合があります。迷っている段階で伝え、決めたら早めに確定させます。</p>' },
  { q: '一日葬にすると香典や弔問はどうなりますか？', a: '<p>一日葬でも香典を受け取るかどうかは家族葬と同様にご家族の方針で決められます。通夜がない分、告別式に来られなかった方が後日弔問に来ることもあるため、返礼品を少量用意しておくと安心です。</p>' },
  { q: '菩提寺が一日葬を認めない場合、どうすればよいですか？', a: '<p>菩提寺によっては「通夜を省くと成仏の妨げになる」として一日葬を認めないことがあります。この場合は家族葬（2日間）にするか、菩提寺に事情を説明して相談します。連絡せずに一日葬を決めてしまうと、納骨を断られることがあるため、日程を決める前に必ず確認します。</p>' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  datePublished: '2026-09-16',
  dateModified: '2026-09-16',
  inLanguage: 'ja',
  author: { '@type': 'Organization', name: '町田ことのは葬祭 編集部' },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: `${SITE.url}/column/ichinichiso-kazokuso/`,
};
---
<ArticleLayout {title} {h1} {description} {toc} {related} pageType="column" lastReviewed=""
  ogType="article" datePublished="2026-09-16" dateModified="2026-09-16" {jsonLd}
  lead="一日葬（通夜を省いて1日で行う）と家族葬（通夜・告別式を2日間で行う）は、どちらも家族・親族中心の小規模な葬儀ですが、日数と費用が異なります。このページでは、費用の差と5つの判断基準、町田市での式場事情をもとに、選び方を説明します。"
  crumbs={[{ href: '/column/', label: '葬儀コラム' }, { href: '/column/ichinichiso-kazokuso/', label: '一日葬と家族葬の選び方' }]}
  bottomCtaPosition="plan" bottomCtaTitle="一日葬・家族葬のご相談" bottomCtaLead="参列予定の人数、菩提寺の有無、参列者の年齢層を伺えば、どちらが向いているか、総額の目安と合わせてお伝えします。">

  <h2 id="chigai">一日葬と家族葬の違いは何ですか？</h2>
  <div class="answer"><p>一日葬は<strong>通夜を行わず、告別式と火葬を1日</strong>で行う形式、家族葬は<strong>通夜と告別式を2日間</strong>で行う形式です。参列者の範囲（家族・親族中心）は同じで、違いは日数と、それに伴う式場使用料・飲食費の差です。町田市では、当サイトのプラン料金は一日葬396,000円、家族葬528,000円（いずれも税込）です。</p></div>
  <div class="table-wrap table-wrap--wide">
    <table>
      <caption>一日葬と家族葬の比較（町田市・南多摩斎場の式場利用を想定）</caption>
      <thead><tr><th scope="col"></th><th scope="col">一日葬</th><th scope="col">家族葬</th></tr></thead>
      <tbody>
        <tr><th scope="row">通夜</th><td>なし</td><td>あり</td></tr>
        <tr><th scope="row">告別式</th><td>あり</td><td>あり</td></tr>
        <tr><th scope="row">日数</th><td>1日（告別式・火葬のみ）</td><td>2日（通夜、翌日に告別式・火葬）</td></tr>
        <tr><th scope="row">参列人数の目安</th><td>5〜10名程度</td><td>10〜30名程度</td></tr>
        <tr><th scope="row">プラン料金（税込）</th><td class="num">396,000円〜</td><td class="num">528,000円〜</td></tr>
        <tr><th scope="row">総額の目安</th><td class="num">10名で約52万円</td><td class="num">20名で約82万円</td></tr>
      </tbody>
    </table>
  </div>
  <p class="note">プラン料金は本サイト（検証用）の設定価格です。総額は南多摩斎場 第二式場（式場使用料50,000円）、火葬料0円（町田市民）、飲食1人5,000円、返礼品1人2,000円で試算した目安で、宗教者へのお礼は含みません。</p>
  <Source items={[{ label: '南多摩斎場 使用料（式場・火葬料）', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' }]} />
  <p>総額の差（約30万円）は、主に通夜振る舞いの飲食費と、通夜1日分の式場設営費によるものです。人数が増えるほど飲食・返礼品の差も広がるため、参列予定人数が多い場合ほど日数による費用差は大きくなります。反対に、参列者が5名程度と少なければ、一日葬と家族葬の総額差は10万円台に収まることもあります。人数と形式の組み合わせによって差額が変わるため、見積もりの段階で内訳を確認しておきます。くわしい内訳は<a href="/plans/ichinichiso/">一日葬</a>と<a href="/plans/kazokuso/">家族葬</a>の各ページで説明しています。</p>

  <h2 id="kijun">一日葬と家族葬、どちらにするかの判断基準は何ですか？</h2>
  <div class="answer"><p>判断基準は、<strong>①参列者の年齢と移動距離、②菩提寺の意向、③参列者が集まりやすい時間帯、④費用差、⑤故人と過ごす時間</strong>の5つです。このうち①と②は、一日葬にできるかどうかを左右する条件になるため、最初に確認します。</p></div>
  <p>①高齢の親族や遠方から来る親族が多い場合、通夜・告別式と2日間の移動・宿泊は負担が大きくなります。一日葬にすれば拘束は半日〜1日で済みます。②菩提寺がある場合は、一日葬（通夜の省略）を認めるかどうかを先に確認する必要があります。認めない菩提寺もあるため、家族だけで決めずに相談します。</p>
  <p>③会社関係の参列者を含める場合、夜の通夜のほうが平日でも参加しやすいことがあります。一方、告別式は日中のため平日は参列しにくい方もいます。会社を休みにくい参列者が多いか、夜であれば来られる参列者が多いかによって、通夜の要不要が変わります。④費用を抑えたい場合は一日葬が有利ですが、差額は参列人数によって変わります。⑤通夜がある家族葬は、故人と過ごす時間が1日長くなる点を重視するご家族もいます。通夜の晩に親族だけで思い出を語り合う時間を大切にしたい場合は、費用差があっても家族葬を選ぶ理由になります。</p>
  <NextLink href="/cost/" label="費用の詳細" title="町田市の葬儀費用｜内訳・人数別の総額例・安く抑える方法" />

  <h2 id="case">ケース別に見る一日葬・家族葬の目安</h2>
  <div class="answer"><p>参列者の顔ぶれと菩提寺の有無で、向いている形式は変わります。5つの典型的なケースで見ると、<strong>親族が遠方・高齢なら一日葬、会社関係も少数参列するなら家族葬、菩提寺が通夜を必須とするなら家族葬</strong>が目安です。</p></div>
  <div class="table-wrap">
    <table>
      <caption>ケース別の判断の目安</caption>
      <thead><tr><th scope="col">ケース</th><th scope="col">目安</th><th scope="col">理由</th></tr></thead>
      <tbody>
        <tr><th scope="row">親族の多くが遠方・高齢</th><td>一日葬</td><td>宿泊・移動の負担を1日分減らせる</td></tr>
        <tr><th scope="row">会社関係や近所の方も少数参列させたい</th><td>家族葬</td><td>通夜なら平日夜でも参列しやすい</td></tr>
        <tr><th scope="row">菩提寺が通夜を必須としている</th><td>家族葬</td><td>一日葬を認めない菩提寺があるため事前確認が必要</td></tr>
        <tr><th scope="row">費用をできるだけ抑えたい</th><td>一日葬</td><td>飲食・式場設営が1日分で済む</td></tr>
        <tr><th scope="row">故人とゆっくりお別れする時間を取りたい</th><td>家族葬</td><td>通夜の分、故人と過ごす時間が長い</td></tr>
      </tbody>
    </table>
  </div>
  <p>実際にはこれらの条件が重なることが多く、たとえば「菩提寺はないが親族は遠方で高齢」なら一日葬、「菩提寺があり会社関係にも一部知らせたい」なら家族葬というように、優先する条件から絞り込みます。複数の条件が異なる形式を指す場合（例: 菩提寺は通夜不要と言っているが親族は少人数で近隣在住）は、家族の負担よりも菩提寺との関係を優先するか、参列のしやすさを優先するかを先に決めておくと、話し合いが進みやすくなります。</p>

  <h2 id="machida">町田市で一日葬・家族葬を選ぶときの事情</h2>
  <div class="answer"><p>町田市では、<strong>南多摩斎場の式場使用料は公式の使用料表（組織市住民: 第二・第三式場50,000円、第一式場140,000円）で確認でき、一日葬での利用条件や通夜後に泊まれるかは斎場に確認が必要です。</strong>民営の式場では2日分の使用料を請求される場合があり、南多摩斎場の混雑時は火葬まで日数がかかることも日数の選択に影響します。</p></div>
  <p>南多摩斎場の式場（第一・第二・第三）は、火葬当日または告別式当日に合わせて借りる形が基本で、通夜から告別式まで泊まり込むことは想定されていません。通夜を行う家族葬でも、通夜の日と告別式の日でそれぞれ式場を借りる（または通し利用）形になるため、事前に空き状況と料金の考え方を確認します。</p>
  <Source items={[{ label: '南多摩斎場 使用料・利用案内', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' }]} />
  <p>市内の民営の家族葬ホールでは、通夜と告別式で式場を連続して使うことが多く、1日分の料金でも実質2日分の拘束になる場合や、逆に2日分の使用料が明示される場合があります。見積もりの際に「式場使用料が何日分か」を確認しておくと、一日葬・家族葬いずれを選ぶ場合も費用の誤差が減ります。また、南多摩斎場は冬季や年末年始に混雑しやすく、火葬まで1週間以上待つことがあるとされるため、待つ間の安置日数が延びる点は一日葬・家族葬のどちらを選んでも共通の考慮事項です。</p>
  <p>安置が長引くと、安置施設の使用料とドライアイス代が日数分積み重なります。一日葬にして式場拘束を短くしても、火葬までの待ち日数自体は南多摩斎場の空き状況で決まるため短縮されるわけではない点は誤解しやすいところです。日程を優先したい場合は、市外の火葬場（横浜市北部斎場・相模原市営斎場など）を使う選択肢も含めて検討します。</p>
  <NextLink href="/halls/" label="式場をくわしく" title="町田市の斎場・葬儀場一覧（公営・民営・寺院）" />
  <Cta position="middle" variant="inline" telText="電話で相談" contactText="メールで相談" />

  <h2 id="kimekata">迷ったときは、どの順番で決めればよいですか？</h2>
  <div class="answer"><p>迷ったときは、<strong>①菩提寺の意向を確認する、②参列させたい人の範囲を決める、③参列者の年齢・移動距離を確認する、④総額の目安を比較する</strong>の順で決めると、家族の希望と現実的な制約の両方を反映できます。</p></div>
  <ol>
    <li>菩提寺がある場合は、一日葬（通夜の省略）を認めるか先に確認する。</li>
    <li>会社関係や友人にも参列してほしいかどうかを、家族で話し合って決める。</li>
    <li>参列予定者の年齢層と移動距離を確認し、1日で終える必要があるか検討する。</li>
    <li>一日葬と家族葬それぞれの総額の目安を人数から見積もり、比較する。</li>
  </ol>
  <p>この順で決めても判断がつかない場合は、参列予定人数と菩提寺の有無を伝えて相談することもできます。当サイトの<a href="/contact/">お問い合わせ・事前相談</a>では、状況を伺ったうえで両方の総額の目安をお伝えします。</p>
  <NextLink href="/plans/" label="プラン全体を比較" title="町田市の葬儀プラン比較（家族葬・一日葬・火葬式）" />

  <h2 id="faq">よくある質問</h2>
  <Faq items={faqs} group="ichinichiso-kazokuso" />
</ArticleLayout>
