];
const related = [
  { href: '/plans/kazokuso/', label: '町田市の家族葬', note: '費用・式場・流れ' },
  { href: '/plans/ichinichiso/', label: '一日葬', note: '通夜を省いて1日で行う' },
  { href: '/flow/', label: '葬儀の流れ', note: '逝去から法要・手続きまで' },
