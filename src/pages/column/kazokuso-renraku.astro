const description = '家族葬で参列を遠慮してもらう相手への訃報の伝え方と、葬儀後の弔問対応を説明します。電話・LINE・葉書の文例、香典・供花を辞退するときの伝え方、四十九日までの自宅弔問への準備をまとめました。';
const toc = [
