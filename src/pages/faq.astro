---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import NextLink from '../components/NextLink.astro';
import Source from '../components/Source.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';

const title = '町田市の葬儀でよくある質問｜費用・火葬場・手続き・家族葬';
const h1 = '町田市の葬儀でよくある質問';
const description = '町田市の葬儀について、費用・南多摩斎場・葬祭費・死亡届・家族葬の人数など、よくある22の質問に町田市の情報にもとづいて直接回答します。';
const toc = [
  { id: 'chokugo', label: '亡くなった直後にすること' },
  { id: 'hiyou', label: '費用について' },
  { id: 'shisetsu', label: '火葬場・式場について' },
  { id: 'keishiki', label: '葬儀の形式について' },
  { id: 'seido', label: '制度・手続きについて' },
  { id: 'sodan', label: '相談について' },
];
const related = [
  { href: '/first-steps/', label: '亡くなってから最初にすること', note: '搬送・安置・死亡届の手順' },
  { href: '/cost/', label: '葬儀費用の内訳と総額例', note: '追加費用と抑え方' },
  { href: '/halls/crematorium/', label: '町田市の火葬場', note: '南多摩斎場の料金・混雑時の代替' },
  { href: '/subsidy/', label: '葬祭費・補助金', note: '国保・後期高齢者医療から50,000円' },
  { href: '/plans/', label: '葬儀プラン比較', note: '家族葬・一日葬・火葬式' },
  { href: '/contact/', label: 'お問い合わせ・事前相談', note: '電話・メールで相談' },
];

const chokugoFaqs = [
  { q: '町田市で亡くなった場合、最初に何をすればいいですか？', a: '<p>医師の死亡確認後、搬送先を決めて葬儀社に安置を依頼します。墓地埋葬法第3条により死亡から24時間は火葬できないため、まず安置が必要です。死亡届は死亡を知った日を含め7日以内に、町田市役所市民課（市庁舎1階104窓口）または忠生・鶴川・南・なるせ駅前・堺・小山の各市民センターに提出します。くわしい手順は<a href="/first-steps/">亡くなってから最初にすること</a>で説明しています。</p>' },
  { q: '病院からすぐに葬儀社を決める必要がありますか？', a: '<p>その場で決める必要はなく、搬送だけを先に依頼することもできます。病院の霊安室は長時間の利用ができないことが多く、数時間以内に安置先へ移す必要がありますが、搬送のみを請け負う業者もあります。落ち着いてから式場や日程を決めても間に合います。</p>' },
  { q: '深夜や早朝でも搬送してもらえますか？', a: '<p>葬儀社の搬送は一般的に24時間対応としているところが多く、深夜・早朝でも依頼できるのが業界の通例です。ただし個々の葬儀社の受付体制や到着までの時間は事業者ごとに異なるため、依頼時に対応可否と到着見込みを直接確認してください。</p>' },
  { q: '自宅で亡くなった場合はどうすればいいですか？', a: '<p>かかりつけ医がいて持病が死因と判断できる場合は、その医師に連絡します。死亡前24時間以内に診察があれば、死亡時に立ち会っていなくても死亡診断書を発行できます。かかりつけ医がいない場合や死因が不明・不自然な場合は警察に連絡し、検視・検案を経て死体検案書が交付されます。</p>' },
];

const hiyouFaqs = [
  { q: '町田市の家族葬はいくらくらいですか？', a: '<p>当サイトの家族葬プラン528,000円（税込・本サイトの設定価格）に、式場使用料と飲食・返礼品を加えた総額は、参列20名で約82万円が目安です。10名なら約70万円、30名なら約94万円になります。町田市民は南多摩斎場の火葬料が無料のため、この試算には火葬料を含めていません。くわしくは<a href="/plans/kazokuso/">家族葬のページ</a>で内訳を説明しています。</p>' },
  { q: '町田市の葬儀費用の相場は？', a: '<p>全国調査では、鎌倉新書「お葬式に関する全国調査」（2024年）で全体平均118.5万円、家族葬105.7万円、一日葬87.5万円、火葬式42.8万円という数値があります。日本消費者協会の調査（2022年3月発行）ではコロナ後の合計額が161.9万円です。これらは全国の喪主経験者を対象にした調査で、寺院費用（お布施）や飲食費を含む一方、式場や地域の条件は個別に異なるため、当サイトのプラン料金＋式場・飲食の試算とは前提が違う点に注意してください。</p>' },
  { q: '火葬式（直葬）はいくらですか？', a: '<p>当サイトの火葬式プラン198,000円（税込・本サイトの設定価格）に、町田市民なら無料の火葬料を組み合わせた総額は約25万円が目安です。式を行わない分、式場使用料と飲食・返礼品がかからないため、家族葬・一日葬より総額を抑えられます。くわしくは<a href="/plans/kasoshiki/">火葬式・直葬のページ</a>で説明しています。</p>' },
  { q: '見積もりより高くなることはありますか？', a: '<p>火葬待ちで安置日数が延びると、ドライアイス代や安置施設の使用料が1日あたり加算されます。参列人数が見込みより増えると飲食・返礼品の費用も増え、搬送距離が想定より長い場合や湯灌（ゆかん：ご遺体を清める儀式）を追加した場合も別途費用がかかります。宗教者へのお礼はプラン料金に含まれず実費です。くわしくは<a href="/cost/">葬儀費用のページ</a>と<a href="/column/kaso-machi-anchi/">火葬待ちと安置費用の考え方</a>で説明しています。</p>' },
];

const shisetsuFaqs = [
  { q: '町田市で利用できる火葬場はどこですか？', a: '<p>町田市内にある公営の火葬場は南多摩斎場（町田市上小山田町）で、八王子市・町田市・多摩市・稲城市・日野市の5市が共同運営しています。町田市民の火葬料は無料です。混雑時は市外の相模原市営斎場（54,000円）、横浜市北部斎場（50,000円）、八王子市斎場（80,000円）も選択肢になります。くわしくは<a href="/halls/crematorium/">町田市の火葬場</a>で比較しています。</p>' },
  { q: '南多摩斎場の火葬料はいくらですか？', a: '<p>八王子市・町田市・多摩市・稲城市・日野市の住民（12歳以上）は無料、市外の方は80,000円（12歳未満は50,000円）です。式場使用料は第二・第三式場が50,000円、第一式場が140,000円（いずれも構成市住民）です。出典は南多摩斎場公式サイトの使用料ページで、上記の表とあわせて確認できます。</p>' },
  { q: '南多摩斎場が混んでいて予約が取れないときは？', a: '<p>南多摩斎場は友引日や年末年始（1月1日〜1月3日）が休場日で、冬季は火葬まで1週間以上待つこともあります。日程を優先する場合は、市外の横浜市北部斎場や相模原市営斎場を使う選択肢もあります。待つ間の安置費用の考え方は<a href="/column/kaso-machi-anchi/">火葬待ちと安置費用の考え方</a>で説明しています。</p>' },
  { q: '町田市に市営の葬儀式場はありますか？', a: '<p>町田市が単独で運営する市営式場はありません。公営の式場機能は南多摩斎場組合の第一・第二・第三式場が担っています。集会施設や市民センターで葬儀ができるかどうかは町田市の公式ページで明記されておらず、利用したい場合は各施設に直接確認する必要があります（未確認）。</p>' },
  { q: '自宅で葬儀はできますか？', a: '<p>式場を使わず自宅で行うことは可能で、式場使用料がかからない点が特徴です。祭壇を設置するスペースと、参列者・霊柩車のための駐車場が必要になります。集会所や市民センターでの葬儀利用可否は町田市の公式情報では確認できていないため、希望する場合は各施設への問い合わせが必要です。</p>' },
];

const keishikiFaqs = [
  { q: '家族葬は何人くらいまでですか？', a: '<p>明確な上限はありませんが、当サイトでは10〜30名程度を目安にしています。30名を超えると式場の広さや飲食の手配が一般葬に近くなるため、見積もりの段階で人数の見込みを伝えることが必要です。くわしくは<a href="/plans/kazokuso/">家族葬のページ</a>で説明しています。</p>' },
  { q: '一日葬と家族葬の違いは何ですか？', a: '<p>家族葬は通夜と告別式を2日間で行い、一日葬は通夜を省いて告別式と火葬のみを1日で行います。プラン料金（税込・本サイトの設定価格）は家族葬528,000円、一日葬396,000円です。判断の目安は<a href="/column/ichinichiso-kazokuso/">一日葬と家族葬、どちらを選ぶか</a>にまとめています。</p>' },
  { q: '菩提寺がない場合はどうすればいいですか？', a: '<p>一日葬や火葬式では、菩提寺（先祖代々の墓を管理する寺院）に事前相談せずに通夜や戒名を省略すると、後日の納骨を断られるトラブルが起きうると複数の葬儀社が案内しています。ただしこれを裏付ける行政・宗教団体側の一次資料は確認できていないため、断定はできません。菩提寺がない場合や遠方の場合は、事前に葬儀社へ相談してください。</p>' },
];

const seidoFaqs = [
  { q: '葬祭費は受け取れますか？', a: '<p>故人が国民健康保険または後期高齢者医療の加入者であれば、喪主に葬祭費50,000円が支給されます。申請期限は葬祭を行った日の翌日から2年で、窓口は市役所1階保険年金課または各市民センターです。オンライン・郵送での申請にも対応しています。社会保険（協会けんぽ等）の加入者は、埋葬料（定額5万円）または埋葬費（実費上限5万円）が支給され、葬祭費とは重複して受け取れません。くわしくは<a href="/subsidy/">葬祭費・補助金のページ</a>で説明しています。</p>' },
  { q: '町田市に市民葬はありますか？', a: '<p>町田市は2022年3月31日で市直営の葬祭事業を終了しています。現在は市内事業者による民間運営の「町田市民葬祭事業組合」（愛称：町田のまちそう、電話0120-568-108）を町田市が案内する形になっています。具体的な料金プランや対象要件は町田市の公式ページでは確認できず、利用を検討する場合は直接問い合わせが必要です（未確認）。</p>' },
  { q: '生活保護を受けていても葬儀はできますか？', a: '<p>生活保護法第18条の葬祭扶助により、検案・搬送・火葬など葬祭に必要な最低限の費用が公費で賄われます。厚生労働省の基準額（令和6年4月1日施行分）は大人21万5,000円以内、子供（12歳未満）17万2,000円以内です。原則として葬儀（火葬）の前に申請する必要があり、窓口は町田市生活援護課（市庁舎1階109窓口、電話042-724-2134）です。</p>' },
  { q: '死亡届はどこに出しますか？', a: '<p>死亡を知った日を含めて7日以内に、死亡地・本籍地・届出人の所在地のいずれかの市区町村に提出します。町田市内では市役所1階市民課戸籍係（104窓口）のほか、忠生・鶴川・南・なるせ駅前・堺・小山の各市民センターでも受け付けています。届出とあわせて火葬許可証が交付されます。</p>' },
];

const sodanFaqs = [
  { q: 'まだ亡くなっていない段階で相談できますか？', a: '<p>亡くなる前の事前相談にも対応する方針です。費用の見込み、希望する式場、菩提寺の有無などを整理しておくと、実際に亡くなったときの判断がスムーズになります。<a href="/contact/">お問い合わせ</a>から電話・メールで相談してください。</p>' },
  { q: '相談や見積もりだけでも構いませんか？', a: '<p>相談や見積もりだけの問い合わせでも構わない方針です。搬送のみの依頼や、費用の目安だけを知りたいという相談も受け付けます。まずは参列予定の人数と希望する式場を伝えていただければ、目安の総額をお伝えします。</p>' },
];

const allFaqs = [...chokugoFaqs, ...hiyouFaqs, ...shisetsuFaqs, ...keishikiFaqs, ...seidoFaqs, ...sodanFaqs];
const strip = (h: string) => h.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
};
---
<ArticleLayout {title} {h1} {description} {toc} {related} pageType="faq" lastReviewed="" {jsonLd}
  lead="町田市で葬儀を行う際に多い質問を、亡くなった直後の対応・費用・火葬場と式場・葬儀の形式・葬祭費などの制度・事前相談の6つのテーマに分けて、数値や条件を含めて直接回答します。"
  crumbs={[{ href: '/faq/', label: 'よくある質問' }]}
  bottomCtaPosition="faq" bottomCtaTitle="ここにない質問も相談できます" bottomCtaLead="費用の目安、南多摩斎場の空き状況、菩提寺との調整など、個別の事情に応じてお答えします。">

  <h2 id="chokugo">亡くなった直後にすること</h2>
  <Faq items={chokugoFaqs} group="chokugo" />
  <NextLink href="/first-steps/" label="くわしい手順" title="亡くなってから最初にすること（搬送・安置・死亡届）" />

  <h2 id="hiyou">費用について</h2>
  <Faq items={hiyouFaqs} group="hiyou" />
  <Cta position="cost" variant="inline" telText="費用について電話で相談" contactText="メールで見積もりを相談" />

  <h2 id="shisetsu">火葬場・式場について</h2>
  <div class="table-wrap table-wrap--wide">
    <table>
      <caption>南多摩斎場と市外の代替火葬場（町田市民の火葬料。税抜表記なし＝公営の使用料は非課税。確認日 2026-09-15）</caption>
      <thead><tr><th scope="col">施設</th><th scope="col">運営</th><th scope="col">火葬料（町田市民）</th><th scope="col">火葬料（市外）</th></tr></thead>
      <tbody>
        <tr data-track-view="hall" data-item="南多摩斎場"><th scope="row">南多摩斎場</th><td>5市共同（公営）</td><td class="num">無料</td><td class="num">80,000円</td></tr>
        <tr data-track-view="hall" data-item="相模原市営斎場"><th scope="row">相模原市営斎場</th><td>相模原市（公営・町田市民は市外扱い）</td><td class="num">—</td><td class="num">54,000円</td></tr>
        <tr data-track-view="hall" data-item="横浜市北部斎場"><th scope="row">横浜市北部斎場</th><td>横浜市（公営・町田市民は市外扱い）</td><td class="num">—</td><td class="num">50,000円</td></tr>
      </tbody>
    </table>
  </div>
  <Source items={[
    { label: '南多摩斎場 使用料', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' },
    { label: '相模原市営斎場 使用料', href: 'https://www.city.sagamihara.kanagawa.jp/_res/projects/default_project/_page_/001/008/627/20160401_ryoukin.pdf' },
    { label: '横浜市 斎場のご案内（料金）', href: 'https://www.city.yokohama.lg.jp/kurashi/sumai-kurashi/saijo/saijo/saijou.html' },
  ]} />
  <Faq items={shisetsuFaqs} group="shisetsu" />
  <NextLink href="/halls/crematorium/" label="火葬場をくわしく" title="町田市の火葬場（南多摩斎場と市外の代替）" />

  <h2 id="keishiki">葬儀の形式について</h2>
  <Faq items={keishikiFaqs} group="keishiki" />

  <h2 id="seido">制度・手続きについて</h2>
  <Faq items={seidoFaqs} group="seido" />
  <NextLink href="/subsidy/" label="葬祭費の申請方法" title="葬祭費・補助金の申請窓口と必要書類" />

  <h2 id="sodan">相談について</h2>
  <Faq items={sodanFaqs} group="sodan" />
</ArticleLayout>
