const title = '町田市の火葬場｜南多摩斎場の料金・予約・休場日と市外の火葬場';
const h1 = '町田市の火葬場｜南多摩斎場の使用料・予約・休場日と、混雑時の市外火葬場';
const description = '町田市に市営火葬場はなく、5市共同運営の南多摩斎場（上小山田町）を使います。町田市民の火葬料は無料、式場・待合室・霊安室の使用料、休場日、混雑時に検討できる相模原市営・横浜市北部斎場など市外火葬場の料金を、公式情報の確認日とともに解説します。';
const toc = [
  { id: 'doko', label: '町田市の火葬場はどこですか？' },
  { id: 'kihon', label: '南多摩斎場の基本情報' },
  { id: 'shiyoryo', label: '南多摩斎場の使用料' },
  { id: 'kyujo', label: '休場日・受付時間・申込方法' },
  { id: 'jikanwaku', label: '火葬の時間枠と当日の流れ' },
  { id: 'machi', label: '火葬まで何日かかる？' },
  { id: 'shigai', label: '町田市民が利用できる市外の火葬場' },
  { id: 'eria', label: 'お住まいのエリア別の使い分け' },
  { id: 'faq', label: 'よくある質問' },
];
const related = [
  { href: '/halls/', label: '町田市の斎場・葬儀場', note: '南多摩斎場の式場と民営式場' },
  { href: '/column/kaso-machi-anchi/', label: '火葬待ちと安置費用の考え方', note: '待つ日数分の安置料の試算' },
  { href: '/plans/kasoshiki/', label: '火葬式・直葬', note: '式を行わず火葬のみで送る形式' },
  { href: '/cost/', label: '葬儀費用の内訳と総額例', note: '火葬料・式場使用料を含む総額' },
  { href: '/area/', label: 'エリア情報', note: 'お住まいの地域から近い式場・火葬場' },
  { href: '/contact/', label: 'お問い合わせ・事前相談', note: '搬送のみのご相談も可能' },
];
const faqs = [
  { q: '町田市外に住んでいる喪主でも、南多摩斎場の火葬料は無料になりますか？', a: '<p>なります。南多摩斎場の火葬料は「死亡時に故人の住民登録があった市」で判定され、喪主の住所は関係ありません。故人が町田市・八王子市・多摩市・稲城市・日野市のいずれかの住民であれば、喪主が構成市外に住んでいても無料です。逆に、故人が構成市外の住民だった場合は、喪主が町田市民でも市外料金（12歳以上80,000円）がかかります。</p>' },
  { q: '南多摩斎場はなぜ友引の日に休みなのですか？', a: '<p>友引（ともびき）は六曜のひとつで、「友を引く」に通じるとして葬儀・火葬を避ける慣習が今も広く残っているためです。南多摩斎場は友引日を基本の休場日としていますが、友引でも開場する日が設定されている場合があります。休場日の詳細は南多摩斎場の公式サイトで確認してください。</p>' },
  { q: '南多摩斎場の予約は自分でできますか？', a: '<p>できます。個人からの電話予約は8:30〜22:00で受け付けています。葬祭業者は24時間対応の受付システムを使いますが、当サイトにご依頼いただいた場合は火葬枠の予約・式場の申込・死亡届の提出をまとめて代行します。搬送のみのご依頼で、ご遺族が予約や届出を行う場合にもご相談に応じます。</p>' },
  { q: '南多摩斎場の式場で通夜はできますか？', a: '<p>できます。第一・第二・第三の3つの式場があり、通夜・告別式のいずれにも使えます。ただし通夜後の宿泊はできないため、ご遺族が付き添って一晩過ごすことはできません。付き添いを希望する場合は、宿泊設備のある民営の家族葬ホールを検討してください。</p>' },
  { q: '南多摩斎場が混んでいて式場が取れない場合、火葬だけ先に済ませられますか？', a: '<p>できます。火葬室と式場は別々に申し込む区分になっており、火葬式（直葬）として火葬のみを行うことも可能です。式場の空きが出るまで日程を分けたい場合や、費用を抑えたい場合の選択肢になります。くわしくは<a href="/plans/kasoshiki/">火葬式・直葬</a>のページで説明しています。</p>' },
];
---
<ArticleLayout {title} {h1} {description} {toc} {related} pageType="hall" lastReviewed="2026-09-15"
  lead="町田市には市営の火葬場はなく、町田市を含む5市が共同で運営する南多摩斎場（町田市上小山田町）を利用します。このページでは南多摩斎場の使用料・休場日・予約方法と、混雑時に検討できる市外の火葬場の料金を、公式サイトで確認できる情報だけで整理します。"
  crumbs={[{ href: '/halls/', label: '斎場・葬儀場' }, { href: '/halls/crematorium/', label: '火葬場' }]}
  bottomCtaPosition="hall" bottomCtaTitle="火葬場の予約・日程のご相談" bottomCtaLead="南多摩斎場の空き状況の確認、市外火葬場との比較、搬送のみのご依頼まで、日程を優先したい場合の選択肢をお伝えします。">

  <h2 id="doko">町田市の火葬場はどこですか？</h2>
  <div class="answer"><p>町田市が単独で運営する市営火葬場は<strong>ありません</strong>。町田市は、八王子市・町田市・多摩市・稲城市・日野市の5市でつくる一部事務組合「南多摩斎場組合」の構成市で、この組合が運営する<strong>南多摩斎場</strong>（東京都町田市上小山田町2147番地）が実質的な「町田市の火葬場」です。死亡時に町田市（または他の4構成市）に住民登録があった方は、南多摩斎場の火葬料が<strong>無料</strong>になります。</p></div>
  <figure class="map-figure">
    <MachidaMap variant="crematoriums" title="町田市と周辺の火葬場の位置関係（概略）" />
    <figcaption>◆ 火葬場　● 主な駅　（位置は概略）</figcaption>
  </figure>
  <div class="facility">
    <div class="facility__head"><h3 class="facility__name">南多摩斎場</h3><span class="facility__sub">公営（南多摩斎場組合）・町田市上小山田町</span></div>
    <div class="facility__grid">
      <div class="facility__cell"><span class="facility__label">特徴</span><p>八王子市・町田市・多摩市・稲城市・日野市の5市が共同運営する、市内唯一の公営火葬場</p></div>
      <div class="facility__cell"><span class="facility__label">料金</span><p class="facility__big">無料<small>町田市民の火葬料（市外 80,000円）</small></p></div>
      <div class="facility__cell"><span class="facility__label">アクセス</span><p>町田駅から直線約7.9km・車で25〜35分程度（目安）。JR横浜線 橋本駅・淵野辺駅から神奈中バス</p></div>
      <div class="facility__cell"><span class="facility__label">向いている人</span><p>町田市民全般。費用を抑えたい方。式場も併設のため、火葬場への移動なしで通夜・告別式まで行いたい方</p></div>
      <div class="facility__cell facility__cell--warn facility__cell--wide"><span class="facility__label">注意点</span><p>友引日（開場日あり）・1月1日〜3日は休場。混雑期は待ちが生じることがあります（公式サイトに待ち日数の公表はなく、経験則の目安です）</p></div>
    </div>
  </div>
  <p>町田市公式サイトも南多摩斎場組合を市の施設のひとつとして案内しており、担当窓口は町田市民部市民総務課（042-724-4346）です。町田市が直接行っていた葬祭事業は2022年3月31日で終了しており、現在は「町田市民葬祭事業組合（愛称: まちそう）」0120-568-108 が案内されています。火葬場と市民葬の窓口は別の組織である点に注意してください。</p>
  <Source items={[
    { label: '町田市公式「南多摩斎場組合」', href: 'https://www.city.machida.tokyo.jp/kurashi/touroku/shisetsu/minamitamasaijyo.html' },
    { label: '南多摩斎場公式「よくある質問」', href: 'https://www.minamitama-saijyo.jp/faq/' },
    { label: '町田市公式「葬儀に関するご案内」', href: 'https://www.city.machida.tokyo.jp/iryo/tiikihukusihoka/sousaijigyou.html' },
  ]} />

  <h2 id="kihon">南多摩斎場の基本情報</h2>
  <div class="answer"><p>南多摩斎場は<strong>東京都町田市上小山田町2147番地</strong>にあり、火葬炉12基、式場3室（第一104席・第二35席・第三80席）、待合室13室、霊安室2室、駐車場約100台を備えています。町田駅からは直線約7.9kmで、車で概ね25〜35分程度（目安）、公共交通ではJR横浜線で橋本駅または淵野辺駅に出て神奈中バスに乗り継ぎます。</p></div>
  <div class="table-wrap">
    <table>
      <caption>南多摩斎場の基本情報（確認日 2026-09-15）</caption>
      <thead><tr><th scope="col">項目</th><th scope="col">内容</th></tr></thead>
      <tbody data-track-view="hall" data-item="南多摩斎場">
        <tr><th scope="row">所在地</th><td>〒194-0201 東京都町田市上小山田町2147番地</td></tr>
        <tr><th scope="row">電話／FAX</th><td>042-797-7641 ／ 042-797-3421</td></tr>
        <tr><th scope="row">運営主体</th><td>南多摩斎場組合（一部事務組合。構成市: 八王子市・町田市・多摩市・稲城市・日野市）</td></tr>
        <tr><th scope="row">設備</th><td>火葬炉12基（前室付台車式）、式場3室、待合室13室（洋室40席）、霊安室2室（6基）</td></tr>
        <tr><th scope="row">駐車場</th><td>約100台（身障者用2台、マイクロバス用11台を含む）</td></tr>
        <tr><th scope="row">アクセス（公共交通）</th><td>JR横浜線 橋本駅または淵野辺駅から神奈中バス。京王相模原線 南大沢駅からタクシー約8分</td></tr>
        <tr><th scope="row">アクセス（車）</th><td>カーナビは「東京都八王子市南大沢3丁目21番地」設定を推奨。混雑時は「南多摩斎場入口」信号からの左折入場を推奨</td></tr>
      </tbody>
    </table>
  </div>
  <p>公式のアクセス案内には掲載されていませんが、直線距離だけで見ると京王相模原線の多摩境駅が最も近く（約1.9km）、町田市西部（相原・多摩境・小山）にお住まいの方には便利な位置です。ただし公式サイトに多摩境駅からのバス・徒歩ルートの案内はないため、利用時は距離が近いことの参考にとどめてください。</p>
  <Source items={[
    { label: '南多摩斎場 公式「館内設備」', href: 'https://www.minamitama-saijyo.jp/guide/facility.php' },
    { label: '南多摩斎場 公式「アクセス」', href: 'https://www.minamitama-saijyo.jp/access/' },
  ]} />

  <h2 id="shiyoryo">南多摩斎場の使用料はいくらですか？</h2>
  <div class="answer"><p>南多摩斎場の使用料は、死亡時に<strong>構成市（八王子市・町田市・多摩市・稲城市・日野市）に住民登録があったかどうか</strong>で2区分に分かれます。町田市民を含む構成市住民は火葬室（12歳以上）が<strong>無料</strong>、市外は80,000円です。式場・待合室・霊安室にも別途使用料がかかります。条例に基づく公営施設の使用料のため、金額に消費税はかかりません（非課税）。</p></div>
  <div class="table-wrap table-wrap--wide">
    <table class="cmp">
      <caption>南多摩斎場の使用料（非課税。町田市を含む組合構成市民／市外の2区分。確認日 2026-09-15）</caption>
      <thead><tr><th scope="col">区分</th><th scope="col">組合構成市民（町田市民を含む）</th><th scope="col">市外</th></tr></thead>
      <tbody data-track-view="hall" data-item="南多摩斎場（使用料）">
        <tr><th scope="row">火葬室 12歳以上</th><td class="num" data-label="組合構成市民">無料</td><td class="num" data-label="市外">80,000円</td></tr>
        <tr><th scope="row">火葬室 12歳未満</th><td class="num" data-label="組合構成市民">無料</td><td class="num" data-label="市外">50,000円</td></tr>
        <tr><th scope="row">火葬室 死胎・改葬・身体の一部</th><td class="num" data-label="組合構成市民">無料</td><td class="num" data-label="市外">30,000円</td></tr>
        <tr><th scope="row">第一式場</th><td class="num" data-label="組合構成市民">140,000円</td><td class="num" data-label="市外">280,000円</td></tr>
        <tr><th scope="row">第二式場</th><td class="num" data-label="組合構成市民">50,000円</td><td class="num" data-label="市外">100,000円</td></tr>
        <tr><th scope="row">第三式場</th><td class="num" data-label="組合構成市民">50,000円</td><td class="num" data-label="市外">100,000円</td></tr>
        <tr><th scope="row">待合室（火葬時・40名定員1室）</th><td class="num" data-label="組合構成市民">無料</td><td class="num" data-label="市外">無料</td></tr>
        <tr><th scope="row">待合室（通夜時）</th><td class="num" data-label="組合構成市民">10,000円</td><td class="num" data-label="市外">10,000円</td></tr>
        <tr><th scope="row">霊安室（2日目＝48時間まで）</th><td class="num" data-label="組合構成市民">3,000円</td><td class="num" data-label="市外" rowspan="2">1日（24時間）につき5,000円</td></tr>
        <tr><th scope="row">霊安室（3日目以降・1日につき）</th><td class="num" data-label="組合構成市民">3,000円</td></tr>
      </tbody>
    </table>
  </div>
  <p class="note">「構成市民」は死亡時の住民登録地で判定します（死胎は父または母、改葬は死亡者または申請者、身体の一部は本人の住民登録地）。市外の火葬室使用料は2026年9月時点の公式ページの金額です。改定時期の記載はなく、古い情報サイトには「50,000円」と書かれたものも残っているため、必ず公式サイトで最新の金額を確認してください。</p>
  <Source items={[
    { label: '南多摩斎場 公式「使用料」', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' },
    { label: '南多摩斎場 公式「火葬申込マニュアル」（PDF）', href: 'https://www.minamitama-saijyo.jp/funeral/pdf/manual_cremate.pdf' },
  ]} />
  <NextLink href="/plans/kasoshiki/" label="火葬のみの費用を見る" title="火葬式・直葬｜プラン198,000円と火葬料の目安" />

  <h2 id="kyujo">南多摩斎場の休場日・受付時間・申込方法</h2>
  <div class="answer"><p>南多摩斎場の休場日は<strong>友引日（開場日もあり）・年始（1月1日〜1月3日）・臨時休場日（年1日）</strong>です。予約は葬祭業者なら24時間対応の受付システム、個人であれば電話（8:30〜22:00）で受け付けています。窓口手続きは8:30〜17:00です。</p></div>
  <div class="table-wrap">
    <table>
      <caption>南多摩斎場の休場日・受付時間（確認日 2026-09-15）</caption>
      <thead><tr><th scope="col">項目</th><th scope="col">内容</th></tr></thead>
      <tbody>
        <tr><th scope="row">休場日</th><td>友引日（開場日あり）、年始（1月1日〜1月3日）、臨時休場日（年1日）。休場日前日・年始開場初日前日の通夜は不可、年始開場初日の告別式は不可</td></tr>
        <tr><th scope="row">予約受付</th><td>葬祭業者: 受付システム（24時間）。個人: 電話 8:30〜22:00</td></tr>
        <tr><th scope="row">窓口手続き</th><td>8:30〜17:00（休場日を除く）</td></tr>
        <tr><th scope="row">火葬受付</th><td>指定した火葬時間の前後15分</td></tr>
        <tr><th scope="row">霊安室の搬入・面会</th><td>8:30〜21:30（17:00以降は警備員対応・要事前連絡）</td></tr>
        <tr><th scope="row">申込期限</th><td>火葬室は火葬日の前日まで、式場は通夜日の前々日まで（受付システム上）</td></tr>
      </tbody>
    </table>
  </div>
  <p>受付システム（誰でも空き状況を閲覧できます）で、直近の火葬枠・式場の空きを事前に確認できます。当サイトにご依頼いただく場合は、この確認と予約の手続きを代行します。</p>
  <Source items={[
    { label: '南多摩斎場 公式「申込方法」', href: 'https://www.minamitama-saijyo.jp/guide/application.php' },
    { label: '南多摩斎場 受付システム', href: 'https://saijyo3.seagulloffice.com/minamitama/user' },
  ]} />

  <h2 id="jikanwaku">火葬の時間枠と当日の流れはどうなっていますか？</h2>
  <div class="answer"><p>南多摩斎場の火葬時間枠は9:00から14:30まで設定されており、<strong>9:30〜13:30は組合構成市住民専用</strong>、9:00・14:00・14:30は構成市住民以外も受け入れます（前日0時以降に空きがあれば全時間帯で受付可）。火葬所要時間は約1時間20分、収骨は約15分です。</p></div>
  <div class="table-wrap">
    <table>
      <caption>南多摩斎場の火葬時間枠（確認日 2026-09-15）</caption>
      <thead><tr><th scope="col">時間枠</th><th scope="col">受入件数</th><th scope="col">受入対象</th></tr></thead>
      <tbody>
        <tr><th scope="row">9:00</th><td class="num">3件</td><td>死胎・身体の一部・改葬、組織市住民、組織市住民以外</td></tr>
        <tr><th scope="row">9:30／10:00／10:30</th><td class="num">各2件</td><td>組織市住民のみ</td></tr>
        <tr><th scope="row">11:00</th><td class="num">3件</td><td>式場利用者（前々日17時までに式場申込がなければ組織市民の火葬受付可）</td></tr>
        <tr><th scope="row">11:30〜13:30</th><td class="num">各2件</td><td>組織市住民のみ</td></tr>
        <tr><th scope="row">14:00</th><td class="num">3件</td><td>組織市住民、組織市住民以外</td></tr>
        <tr><th scope="row">14:30</th><td class="num">2件</td><td>組織市住民、組織市住民以外</td></tr>
      </tbody>
    </table>
  </div>
  <p>火葬炉前でのお別れ・花入れは5分以内という案内があります。大型棺（高さ50cm・幅63cm・長さ200cm以上）は火葬できず、遺体と棺の合計が150kgを超える場合は事前連絡が必要です。当日は指定時間の前後15分が受付時間となるため、霊柩車の到着時刻には余裕を持たせます。</p>
  <Source items={[{ label: '南多摩斎場 公式「火葬申込マニュアル」（PDF）', href: 'https://www.minamitama-saijyo.jp/funeral/pdf/manual_cremate.pdf' }]} />

  <h2 id="machi">町田市で火葬まで何日かかりますか？</h2>
  <div class="answer"><p>南多摩斎場の平均的な待ち日数は<strong>公式サイトで公表されていません（未確認）</strong>。空き状況は受付システムで誰でも確認でき、火葬室12歳以上の受入枠は9:00〜14:30に1日20件前後（時間帯ごとに2〜3件）です。実際に何日後の枠が空いているかは、受付システムで直接確認するか、当サイトへの相談時にお伝えします。</p></div>
  <p>南多摩斎場は町田市を含む5市で1施設を共同利用するため、友引による休場日の翌日や年末年始開場初日の前後は予約が集中しやすくなります。待つ日数の分だけ安置施設の使用料とドライアイス代がかかります。日程を優先する場合は、次の章で説明する市外の火葬場を検討する余地があります。待つあいだの安置費用の考え方は<a href="/column/kaso-machi-anchi/">南多摩斎場が混んでいるとき：火葬待ちと安置費用の考え方</a>で詳しく説明しています。</p>
  <Source items={[{ label: '南多摩斎場 公式「火葬申込マニュアル」（PDF）', href: 'https://www.minamitama-saijyo.jp/funeral/pdf/manual_cremate.pdf' }, { label: '南多摩斎場 受付システム', href: 'https://saijyo3.seagulloffice.com/minamitama/user' }]} />
  <Cta position="hall" variant="inline" telText="空き状況を電話で相談" contactText="メールで日程を相談" />

  <h2 id="shigai">町田市民が利用できる市外の火葬場はどこですか？</h2>
  <div class="answer"><p>南多摩斎場が混雑している場合や友引休場と重なる場合は、<strong>相模原市営斎場・横浜市北部斎場・八王子市斎場・かわさき北部斎苑</strong>などの市外火葬場を検討できます。町田市民が利用すると火葬料は市外料金になり、南多摩斎場の無料と比べて50,000〜80,000円程度の負担が生じます。</p></div>
