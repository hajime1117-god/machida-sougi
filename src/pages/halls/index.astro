---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import NextLink from '../../components/NextLink.astro';
import Source from '../../components/Source.astro';
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import facilityPhoto from '../../assets/photos/round-window.jpg';

const title = '町田市の斎場・葬儀場一覧｜公営の式場・民営ホール・寺院の使い方';
const h1 = '町田市の斎場・葬儀場｜南多摩斎場の式場と民営ホール・寺院・自宅の選び方';
const description = '町田市に市営の斎場はなく、公営で使えるのは南多摩斎場（第一〜第三式場）です。民営の家族葬ホール、寺院会館、自宅葬の使用料・条件を公式情報で整理し、式場の選び方を説明します。';
const toc = [
  { id: 'koei', label: '町田市に公営の式場はあるか' },
  { id: 'minamitama', label: '南多摩斎場の式場' },
  { id: 'minei', label: '町田市内の民営葬儀式場' },
  { id: 'jiin', label: '寺院・教会で葬儀をする場合' },
  { id: 'jitaku', label: '自宅葬・集会所' },
  { id: 'erabikata', label: '式場の選び方' },
  { id: 'area', label: 'エリア別に探す' },
  { id: 'faq', label: 'よくある質問' },
];
const related = [
  { href: '/halls/crematorium/', label: '町田市の火葬場', note: '南多摩斎場の料金・予約・混雑時の代替' },
  { href: '/area/', label: 'エリア情報', note: '駅・地域ごとの式場選び' },
  { href: '/plans/kazokuso/', label: '家族葬', note: '式場使用料を含めた総額の目安' },
  { href: '/cost/', label: '葬儀費用', note: '式場使用料と飲食・返礼品の内訳' },
  { href: '/contact/', label: 'お問い合わせ', note: '式場・日程の相談' },
];
const faqs = [
  { q: '町田市営の斎場・葬儀場はありますか？', a: '<p>町田市が単独で運営する市営斎場は確認できませんでした。町田市公式サイトが案内しているのは、八王子市・町田市・多摩市・稲城市・日野市の5市で構成する一部事務組合「南多摩斎場組合」が運営する南多摩斎場（町田市上小山田町）です。市が直接行う葬祭事業は2022年3月31日で終了しており、現在は町田市民葬祭事業組合（愛称：町田のまちそう、0120-568-108）が案内されています。</p>' },
  { q: '南多摩斎場の式場は誰でも予約できますか？', a: '<p>予約自体は組合構成5市（八王子・町田・多摩・稲城・日野）の住民以外でも可能ですが、使用料は住民（構成市）と非住民で異なります。第一式場は住民140,000円・非住民280,000円、第二・第三式場は住民50,000円・非住民100,000円です（2026年9月15日確認）。予約は葬祭業者向けの受付システム（24時間）か、個人の場合は電話（8:30〜22:00）で行います。</p>' },
  { q: '町田市内の民営ホールは駅から近いですか？', a: '<p>施設によります。湘和会堂町田（森野）は町田駅から徒歩5分、コムウェルホール町田駅前会堂けやき（原町田）は徒歩2分です。小さなお葬式 南町田ホールは南町田グランベリーパーク駅から徒歩9分、鶴川ホールや旭町ホールはバス利用が必要です。駅からの距離は各施設の公式サイトで確認してください。</p>' },
  { q: '寺院や自宅で葬儀をすることはできますか？', a: '<p>町田市内には千手院岩子会館など寺院に併設された会館が複数ありますが、檀家（だんか：その寺を菩提寺とする家）以外の利用可否や費用を明記した公式情報は確認できませんでした。利用には各寺院への直接の問い合わせが必要です。自宅葬は式場使用料がかからず、対応する葬儀社もありますが、市民センターや集会施設が葬儀に利用できるかどうかを示す町田市の公式な案内文は確認できていません。</p>' },
];
---
<ArticleLayout {title} {h1} {description} {toc} {related} pageType="hall" lastReviewed=""
  lead="町田市で葬儀を行う式場は、南多摩斎場の式場（公営）、市内各地の民営葬儀ホール、寺院の会館、自宅の4種類に大きく分かれます。このページでは、それぞれの使用料・立地・利用条件を公式情報で確認できる範囲で整理し、人数や火葬場との距離に応じた選び方を説明します。"
  crumbs={[{ href: '/halls/', label: '斎場・葬儀場' }]}
  bottomCtaPosition="hall" bottomCtaTitle="式場選びのご相談" bottomCtaLead="参列予定の人数、火葬場との距離、宿泊の希望を伺えば、南多摩斎場と民営ホールのどちらが合うか、その場でお伝えします。">

  <ul class="fact-list citizen-strip" aria-label="町田市民が斎場を選ぶときのポイント">
    <li><Icon name="check" /><span><strong>町田市民は南多摩斎場の火葬料が無料</strong>（市外の方は12歳以上80,000円）</span></li>
    <li><Icon name="check" /><span>市営の葬儀式場はなく、公営で使えるのは<strong>南多摩斎場の式場</strong>（第一〜第三式場）</span></li>
    <li><Icon name="check" /><span>駅から近い場所や通夜後の付き添いを重視するなら<strong>民営ホール</strong>。式場の費用は施設ごとに異なります</span></li>
  </ul>
  <h2 id="koei">町田市に公営の葬儀式場はありますか？</h2>
  <div class="answer"><p>町田市が単独で運営する「市営斎場」「市民斎場」は<strong>確認できません</strong>。公営で使えるのは、八王子市・町田市・多摩市・稲城市・日野市の5市が共同で運営する一部事務組合「南多摩斎場組合」の<strong>南多摩斎場</strong>（町田市上小山田町2147）で、火葬場に第一〜第三の3式場が併設されています。町田市公式サイトも南多摩斎場組合を市の施設として案内しており、詳細は組合の公式サイトを参照する構成です。</p></div>
  <ul class="choice choice--2">
    <li><span class="choice__q">費用を抑えたい</span><span class="choice__a"><strong>南多摩斎場の第二・第三式場</strong>（組合構成市住民50,000円）</span><a href="#minamitama" class="btn btn--outline">くわしく見る</a></li>
    <li><span class="choice__q">火葬場への移動をなくしたい</span><span class="choice__a"><strong>南多摩斎場の式場</strong>（火葬場と同じ敷地で移動不要）</span><a href="/halls/crematorium/" class="btn btn--outline">火葬場ページへ</a></li>
    <li><span class="choice__q">駅から近い場所で行いたい</span><span class="choice__a"><strong>民営ホール</strong>（町田駅周辺・鶴川・成瀬など）</span><a href="#minei" class="btn btn--outline">くわしく見る</a></li>
    <li><span class="choice__q">通夜後に付き添って泊まりたい</span><span class="choice__a"><strong>民営ホール</strong>（宿泊可否は施設に確認）</span><a href="#minei" class="btn btn--outline">くわしく見る</a></li>
    <li><span class="choice__q">菩提寺が市内にある</span><span class="choice__a"><strong>寺院の会館</strong>（利用可否は寺院に要確認）</span><a href="#jiin" class="btn btn--outline">くわしく見る</a></li>
    <li><span class="choice__q">住み慣れた家から送り出したい</span><span class="choice__a"><strong>自宅葬</strong>（式場使用料はかからない）</span><a href="#jitaku" class="btn btn--outline">くわしく見る</a></li>
  </ul>
  <p>町田市が直接行っていた葬祭事業は2022年3月31日で終了し、現在は町田市民葬祭事業組合（愛称：町田のまちそう、0120-568-108）が案内されています。この組合と南多摩斎場組合は別の組織で、南多摩斎場組合が火葬場・式場を運営し、町田のまちそうは葬祭事業の案内窓口という位置づけです。市民センター（忠生・鶴川・南・なるせ駅前・堺・小山）や自治会館などの集会施設が葬儀に利用できるかどうかを明記した町田市の公式な案内文は、今回の確認範囲では見つかりませんでした。利用を検討する場合は各施設や町田市の担当課へ直接確認してください。</p>
  <Source items={[
    { label: '町田市公式サイト 南多摩斎場組合', href: 'https://www.city.machida.tokyo.jp/kurashi/touroku/shisetsu/minamitamasaijyo.html' },
    { label: '町田市公式サイト 葬儀に関するご案内（町田のまちそう）', href: 'https://www.city.machida.tokyo.jp/iryo/tiikihukusihoka/sousaijigyou.html' },
  ]} />

  <h2 id="minamitama">南多摩斎場の式場はどのような構成ですか？</h2>
  <div class="answer"><p>南多摩斎場には<strong>第一式場（140,000円）、第二式場（50,000円）、第三式場（50,000円）</strong>の3室があり、料金は組合構成5市（八王子・町田・多摩・稲城・日野）の住民の場合です（税表記なし＝公営の使用料は消費税非課税）。非住民は第一式場280,000円、第二・第三式場100,000円です。いずれの式場も祭壇が常備され、火葬場と同じ敷地にあるため、通夜・告別式から火葬までの移動がありません。</p></div>
  <div class="table-wrap table-wrap--wide">
    <table>
      <caption>南多摩斎場 式場・付帯設備の使用料（2026年9月15日 南多摩斎場公式サイト「使用料」ページで確認。税表記なし＝非課税）</caption>
      <thead><tr><th scope="col">項目</th><th scope="col">組合構成市（町田市を含む）住民</th><th scope="col">非住民</th></tr></thead>
      <tbody data-track-view="hall" data-item="南多摩斎場">
        <tr><th scope="row">第一式場</th><td class="num">140,000円</td><td class="num">280,000円</td></tr>
        <tr><th scope="row">第二式場</th><td class="num">50,000円</td><td class="num">100,000円</td></tr>
        <tr><th scope="row">第三式場</th><td class="num">50,000円</td><td class="num">100,000円</td></tr>
        <tr><th scope="row">待合室（通夜時）</th><td class="num">10,000円</td><td class="num">10,000円</td></tr>
        <tr><th scope="row">霊安室（2日目＝48時間まで）</th><td class="num">3,000円</td><td class="num">5,000円／日</td></tr>
      </tbody>
    </table>
  </div>
  <Source items={[{ label: '南多摩斎場公式サイト 使用料', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' }]} />
  <div class="facility">
    <div class="facility__head"><h3 class="facility__name">南多摩斎場</h3><span class="facility__sub">公営（南多摩斎場組合）・町田市上小山田町2147</span></div>
    <div class="facility__visual"><Photo src={facilityPhoto} alt="落ち着いた和室と緑のイメージ" widths={[480, 800]} sizes="(min-width: 768px) 360px, 100vw" ratio="3/2" caption="式場のイメージ写真。実在の南多摩斎場ではありません" /></div>
  <div class="facility__grid">
      <div class="facility__cell"><span class="facility__label">特徴</span><p>祭壇常備、火葬場と同じ敷地で移動なし、遺族控室あり（通夜後に泊まれるかは斎場に確認）</p></div>
      <div class="facility__cell"><span class="facility__label">料金</span><p class="facility__big">50,000円<small>第二・第三式場／組合構成市住民</small></p><p>第一式場140,000円（住民）</p></div>
      <div class="facility__cell"><span class="facility__label">アクセス</span><p>南大沢駅・相模原駅からタクシー、駐車場約100台</p></div>
      <div class="facility__cell"><span class="facility__label">向いている人</span><p>費用を抑えたい人、火葬場への移動をなくしたい人</p></div>
      <div class="facility__cell facility__cell--warn facility__cell--wide"><span class="facility__label">注意点</span><p>友引日・年始（1月1日〜3日）は休場日。式場の申込期限は通夜日の前々日まで。詳細は南多摩斎場へ直接確認。</p></div>
    </div>
  </div>
  <p>式場のほかに、洋室40席の待合室が13室、霊安室2室（面会は8:30〜21:30、17:00以降は警備員対応・要事前連絡）、駐車場約100台（身障者用2台・マイクロバス用11台を含む）が確認されています。各式場には寺院関係控室・和室8畳・ユニットシャワー付き遺族控室が併設され、<strong>遺族控室での宿泊が可能</strong>です。人数や設備の詳細条件は南多摩斎場へ直接確認してください。</p>
  <Source items={[{ label: '南多摩斎場公式サイト 館内設備', href: 'https://www.minamitama-saijyo.jp/guide/facility.php' }]} />
  <p>予約は葬祭業者向けの受付システム（24時間受付）で行うのが基本で、個人が申し込む場合は電話（8:30〜22:00）を利用します。窓口手続きは8:30〜17:00（休場日を除く）、式場の申込期限は通夜日の前々日までです。友引日や年始（1月1日〜3日）は休場日にあたり、休場日前日と年始開場初日前日の通夜、年始開場初日の告別式はできません。</p>
  <Source items={[{ label: '南多摩斎場公式サイト 申込方法', href: 'https://www.minamitama-saijyo.jp/guide/application.php' }]} />
  <NextLink href="/halls/crematorium/" label="火葬料金・予約・混雑をくわしく" title="町田市の火葬場（南多摩斎場の料金・予約・友引・アクセス）" />

  <h2 id="minei">町田市内の民営葬儀式場にはどのようなものがありますか？</h2>
  <div class="answer"><p>町田市内には、公式サイトで所在地・運営会社などを確認できる民営の葬儀式場が複数あります。町田駅周辺に多く、<strong>湘和会堂町田（森野・徒歩5分）</strong>や<strong>コムウェルホール町田駅前会堂けやき（原町田・徒歩2分）</strong>のように駅近の施設もあれば、旭町・鶴川・南町田など駅からバスや徒歩10分以上の施設もあります。使用料は施設によって異なり、公式サイトに金額の明記がないものが大半です。</p></div>
  <div class="table-wrap table-wrap--wide">
    <table class="cmp">
      <caption>町田市内の民営葬儀式場（公式サイトで所在地等を確認できた施設。2026年9月15日確認。使用料は各社に個別確認が必要）</caption>
      <thead><tr><th scope="col">名称</th><th scope="col">所在地（町名）</th><th scope="col">最寄駅</th><th scope="col">運営会社</th><th scope="col">規模</th></tr></thead>
      <tbody>
        <tr data-track-view="hall" data-item="エンディングハウス町田"><th scope="row">エンディングハウス町田 <span class="badge">民営</span></th><td data-label="所在地">旭町</td><td data-label="最寄駅">町田駅よりバス「市民病院前」下車徒歩約7分</td><td data-label="運営会社">株式会社公益社</td><td data-label="規模">ホール20席・推奨1〜30名</td></tr>
        <tr data-track-view="hall" data-item="小さな家族葬ハウス町田木曽"><th scope="row">小さな家族葬ハウス町田木曽 <span class="badge">民営</span></th><td data-label="所在地">木曽東</td><td data-label="最寄駅">未確認</td><td data-label="運営会社">株式会社永田屋</td><td data-label="規模">未確認</td></tr>
        <tr data-track-view="hall" data-item="小さな家族葬ハウス町田成瀬"><th scope="row">小さな家族葬ハウス町田成瀬 <span class="badge">民営</span></th><td data-label="所在地">成瀬が丘</td><td data-label="最寄駅">未確認</td><td data-label="運営会社">株式会社永田屋</td><td data-label="規模">未確認</td></tr>
        <tr data-track-view="hall" data-item="くらしの友 町田総合斎場"><th scope="row">くらしの友 町田総合斎場 <span class="badge">民営</span></th><td data-label="所在地">金森東</td><td data-label="最寄駅">町田駅中央改札北口より徒歩約15分</td><td data-label="運営会社">株式会社くらしの友（直営）</td><td data-label="規模">2階約40席・3階約20席、全館で最大500名</td></tr>
        <tr data-track-view="hall" data-item="湘和会堂町田"><th scope="row">湘和会堂町田 <span class="badge">民営</span> <span class="badge">駅近</span></th><td data-label="所在地">森野</td><td data-label="最寄駅">町田駅より徒歩5分</td><td data-label="運営会社">平安レイサービス株式会社</td><td data-label="規模">各式場5〜150名、全館で最大500名</td></tr>
        <tr data-track-view="hall" data-item="家族葬の四季風 鶴川"><th scope="row">家族葬の四季風 鶴川 <span class="badge">民営</span></th><td data-label="所在地">野津田町</td><td data-label="最寄駅">バス停「袋橋」下車徒歩2分</td><td data-label="運営会社">株式会社コムウェル</td><td data-label="規模">未確認</td></tr>
        <tr data-track-view="hall" data-item="コムウェルホール町田駅前会堂けやき"><th scope="row">コムウェルホール町田駅前会堂けやき <span class="badge">民営</span> <span class="badge">駅近</span></th><td data-label="所在地">原町田</td><td data-label="最寄駅">町田駅より徒歩2分</td><td data-label="運営会社">株式会社コムウェル</td><td data-label="規模">未確認（大型葬対応と案内）</td></tr>
        <tr data-track-view="hall" data-item="トレセレホール町田店"><th scope="row">トレセレホール町田店 <span class="badge">民営</span></th><td data-label="所在地">中町</td><td data-label="最寄駅">小田急町田駅徒歩約11分・JR横浜線町田駅徒歩約14分</td><td data-label="運営会社">未確認</td><td data-label="規模">一日一組限定貸切</td></tr>
        <tr data-track-view="hall" data-item="小さなお葬式 町田旭町ホール"><th scope="row">小さなお葬式 町田旭町ホール <span class="badge">民営</span></th><td data-label="所在地">旭町</td><td data-label="最寄駅">町田駅よりバス12分</td><td data-label="運営会社">小さなお葬式（株式会社ユニクエスト）</td><td data-label="規模">〜30名</td></tr>
        <tr data-track-view="hall" data-item="小さなお葬式 鶴川ホール"><th scope="row">小さなお葬式 鶴川ホール <span class="badge">民営</span></th><td data-label="所在地">金井ヶ丘</td><td data-label="最寄駅">鶴川駅よりバス10分</td><td data-label="運営会社">小さなお葬式（株式会社ユニクエスト）</td><td data-label="規模">〜30名</td></tr>
        <tr data-track-view="hall" data-item="小さなお葬式 南町田ホール"><th scope="row">小さなお葬式 南町田ホール <span class="badge">民営</span></th><td data-label="所在地">南町田</td><td data-label="最寄駅">南町田グランベリーパーク駅より徒歩9分</td><td data-label="運営会社">小さなお葬式（株式会社ユニクエスト）</td><td data-label="規模">〜30名</td></tr>
      </tbody>
    </table>
  </div>
  <p class="note">運営会社「小さなお葬式（株式会社ユニクエスト）」の社名表記は各施設ページ本文では確認できておらず、ブランド運営元としての参考情報です。上記施設は情報提供を目的とした掲載で、当サイトが運営・提携している式場ではありません。</p>
