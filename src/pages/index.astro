---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Source from '../components/Source.astro';
import { BRAND, PHONE, SITE } from '../config/site';

const title = '町田市の葬儀・家族葬｜費用・斎場・手続きを分かりやすく案内｜町田ことのは葬祭';
const description = '町田市の家族葬・一日葬・火葬式（直葬）の費用と流れ、南多摩斎場など町田市で使える斎場・火葬場、葬祭費5万円の申請まで、出典付きで分かりやすく解説。深夜・早朝のご相談にも対応します。';

const plans = [
  { slug: 'kazokuso', name: '家族葬', price: '528,000', desc: '通夜と告別式を2日間で行う、家族・親族中心の葬儀。10〜30名程度。', points: ['通夜・告別式あり', '式場を利用', 'ゆっくりお別れしたい方に'] },
  { slug: 'ichinichiso', name: '一日葬', price: '396,000', desc: '通夜を省き、告別式と火葬を1日で行う葬儀。高齢の参列者や遠方の親族の負担を減らせます。', points: ['告別式のみ・1日', '式場を利用', '参列者の負担を軽く'] },
  { slug: 'kasoshiki', name: '火葬式・直葬', price: '198,000', desc: '式を行わず、安置後に火葬場でお別れをする最もシンプルな形式。', points: ['式なし・火葬のみ', '式場費用が不要', '費用を抑えたい方に'] },
];

const faqs = [
  { q: '町田市で亡くなった場合、最初に何をすればいいですか？', a: '<p>まず葬儀社に連絡して、ご遺体の搬送と安置先を決めます。病院で亡くなった場合、数時間以内に霊安室から移動を求められることが多いためです。葬儀の形式や式場は搬送後に落ち着いて決めて構いません。死亡届は亡くなったことを知った日から7日以内に町田市役所市民課などへ提出します。詳しくは<a href="/first-steps/">亡くなってから最初にすること</a>をご覧ください。</p>' },
  { q: '町田市の家族葬はいくらくらいですか？', a: '<p>当サイトの家族葬プランは528,000円（税込）からで、式場使用料・飲食・返礼品・宗教者へのお礼は別途です。南多摩斎場を利用する町田市民は火葬料が無料のため、火葬場の費用を抑えられます。参列人数別の総額例は<a href="/cost/">葬儀費用</a>のページで解説しています。</p>' },
  { q: '町田市で利用できる火葬場はどこですか？', a: '<p>町田市内の公営火葬場は南多摩斎場（町田市上小山田町）の1か所です。町田市を含む組織5市の住民は火葬料が無料です。混雑時は横浜市北部斎場や相模原市営斎場など市外の火葬場も利用できますが、市外料金がかかります。<a href="/halls/crematorium/">町田市の火葬場</a>で料金と使い分けを説明しています。</p>' },
  { q: '葬祭費は受け取れますか？', a: '<p>故人が町田市の国民健康保険または後期高齢者医療制度に加入していた場合、葬儀を行った喪主に葬祭費50,000円が支給されます。申請期限は葬儀の翌日から2年です。会社の健康保険に加入していた場合は、健康保険から埋葬料が支給されます。<a href="/subsidy/">葬祭費・補助金</a>で申請方法を確認できます。</p>' },
  { q: '病院からすぐに葬儀社を決める必要がありますか？', a: '<p>搬送と安置を依頼する葬儀社は急いで決める必要がありますが、葬儀そのものを同じ葬儀社に頼む義務はありません。搬送だけを依頼し、安置後に葬儀の内容と依頼先を検討することができます。当サイトでも搬送のみのご依頼をお受けしています。</p>' },
];

const areas = [
  { href: '/area/machida-eki/', label: '町田駅周辺', note: '原町田・森野・中町・木曽・忠生' },
  { href: '/area/tsurukawa/', label: '鶴川・玉川学園前', note: '能ヶ谷・金井・薬師台・三輪' },
  { href: '/area/naruse/', label: '成瀬・高ヶ坂', note: '成瀬台・南成瀬・西成瀬' },
  { href: '/area/minami-machida/', label: '南町田・つくし野・すずかけ台', note: '鶴間・金森・小川' },
  { href: '/area/tamasakai-aihara/', label: '多摩境・相原・小山', note: '小山ヶ丘・相原町・小山町' },
];
---
<BaseLayout title={title} description={description} pageType="top" fixedCta={{ contactText: '費用を相談' }}>
  <!-- Hero -->
  <section class="hero" data-region="hero" aria-labelledby="hero-h">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">東京都町田市の葬儀社サイト</p>
        <h1 id="hero-h">町田市の葬儀・家族葬を、<br class="br-sp" />費用と斎場から分かりやすく</h1>
        <p class="hero__lead">{BRAND.name}は、町田市の家族葬・一日葬・火葬式（直葬）を扱う葬儀社サイトです。費用の内訳、南多摩斎場をはじめとする斎場・火葬場の使い方、亡くなった直後の手続きまで、町田市の実情に合わせて案内します。</p>
        <ul class="hero__facts" aria-label="町田市で葬儀をするときに知っておきたいこと">
          <li><Icon name="check" /><span>南多摩斎場は<strong>町田市民の火葬料が無料</strong></span></li>
          <li><Icon name="check" /><span>国保・後期高齢者医療の<strong>葬祭費50,000円</strong>が受け取れる</span></li>
          <li><Icon name="check" /><span>搬送のみのご依頼も可。<strong>深夜・早朝も受付</strong></span></li>
        </ul>
        <div class="hero__actions">
          <a href={PHONE.tel} class="btn btn--tel btn--lg" data-cta="tel" data-cta-position="hero"><Icon name="phone" /><span>電話で相談する <span class="num">{PHONE.display}</span></span></a>
          <a href="/cost/" class="btn btn--outline btn--lg" data-cta="cta" data-cta-position="hero"><Icon name="doc" /><span>費用の目安を見る</span></a>
        </div>
        <p class="hero__note">{PHONE.hours}　{PHONE.note}</p>
      </div>
      <a href="/first-steps/" class="hero__urgent">
        <span class="hero__urgent-label">病院・施設から連絡を受けた方へ</span>
        <span class="hero__urgent-title">亡くなってから最初にすること（搬送・安置・死亡届）</span>
        <Icon name="arrow" />
      </a>
    </div>
  </section>

  <!-- 状況から選ぶ -->
  <section class="section" aria-labelledby="start-h">
    <div class="container">
      <h2 id="start-h" class="section-title">今の状況に合わせて選ぶ</h2>
      <div class="grid grid--3 starts">
        <a href="/first-steps/" class="start">
          <span class="start__label">今すぐ</span>
          <span class="start__title">すでに亡くなった・危篤と言われた</span>
          <span class="start__desc">搬送先と安置の決め方、死亡届、最初の24時間ですること。</span>
        </a>
        <a href="/cost/" class="start">
          <span class="start__label">費用を知りたい</span>
          <span class="start__title">町田市の葬儀費用と総額の目安</span>
          <span class="start__desc">形式別・人数別の総額例、追加になりやすい費用、安く抑える方法。</span>
        </a>
        <a href="/plans/" class="start">
          <span class="start__label">事前に備えたい</span>
          <span class="start__title">葬儀の形式を比べて決めておく</span>
          <span class="start__desc">家族葬・一日葬・火葬式の違いと向き不向き。事前相談も受け付けています。</span>
        </a>
      </div>
    </div>
  </section>

  <!-- プラン -->
  <section class="section section--alt" aria-labelledby="plans-h">
    <div class="container">
      <h2 id="plans-h" class="section-title">町田市の葬儀プラン</h2>
      <p class="section-lead">プラン料金には、町田市内の搬送・2日間の安置・棺・ドライアイス・骨壺・火葬場の手続き・当日の進行が含まれます。式場使用料、火葬料（南多摩斎場は町田市民無料）、飲食・返礼品、宗教者へのお礼は別途です。</p>
      <div class="grid grid--3">
        {plans.map((p) => (
          <article class="plan" data-track-view="plan" data-item={p.name} data-region="plan">
            <h3 class="plan__name"><a href={`/plans/${p.slug}/`}>{p.name}</a></h3>
            <p class="plan__price"><span class="num">{p.price}</span><span class="plan__unit">円（税込）〜</span></p>
            <p class="plan__desc">{p.desc}</p>
            <ul class="plan__points">{p.points.map((pt) => <li><Icon name="check" />{pt}</li>)}</ul>
            <a href={`/plans/${p.slug}/`} class="plan__link">{p.name}の内容と費用を見る<Icon name="chevron" /></a>
          </article>
        ))}
      </div>
      <p class="note" style="margin-top:1rem">料金は本サイト（検証用）の設定価格です。<a href="/plans/">3つの形式の比較表</a>で、日程・参列人数・向いている方の違いを確認できます。</p>
    </div>
  </section>

  <!-- 費用 -->
  <section class="section" aria-labelledby="cost-h">
    <div class="container">
      <div class="article">
        <h2 id="cost-h" class="section-title">町田市で葬儀をすると、総額はいくらかかる？</h2>
        <div class="answer"><p>町田市で南多摩斎場を利用する場合、火葬式で<strong>約25万円</strong>、一日葬で<strong>約50〜65万円</strong>、家族葬（20名）で<strong>約75〜95万円</strong>が総額の目安です。差が出るのは、式場使用料・参列人数に応じた飲食と返礼品・宗教者へのお礼の3つです。</p></div>
        <div class="table-wrap">
          <table>
            <caption>形式別の総額目安（町田市民・南多摩斎場利用・仏式で僧侶を呼ぶ場合の一例。税込）</caption>
            <thead><tr><th scope="col">形式</th><th scope="col">プラン料金</th><th scope="col">式場使用料</th><th scope="col">火葬料</th><th scope="col">飲食・返礼品</th><th scope="col">総額目安</th></tr></thead>
            <tbody>
              <tr><th scope="row">火葬式・直葬</th><td class="num">198,000円</td><td>不要</td><td>0円</td><td>不要</td><td class="num"><strong>約25万円</strong>（お布施別）</td></tr>
              <tr><th scope="row">一日葬（10名）</th><td class="num">396,000円</td><td class="num">50,000〜140,000円</td><td>0円</td><td class="num">約5〜8万円</td><td class="num"><strong>約50〜65万円</strong>（お布施別）</td></tr>
              <tr><th scope="row">家族葬（20名）</th><td class="num">528,000円</td><td class="num">50,000〜140,000円</td><td>0円</td><td class="num">約15〜25万円</td><td class="num"><strong>約75〜95万円</strong>（お布施別）</td></tr>
            </tbody>
          </table>
        </div>
        <p class="note">式場使用料は南多摩斎場の第二・第三式場50,000円〜第一式場140,000円（組織市住民）を例にしています。民営式場は施設により異なります。故人が国保・後期高齢者医療の加入者なら、葬祭費50,000円が後日支給されます。</p>
        <Source items={[{ label: '南多摩斎場 使用料', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' }, { label: '町田市 葬祭費', href: 'https://www.city.machida.tokyo.jp/kurashi/hoken/kokuho/ironnakyuufu/sousai.html' }]} />
        <p><a href="/cost/" class="next-link"><span><span class="next-link__label">くわしく見る</span>葬儀費用の内訳・人数別の総額例・安く抑える方法</span><Icon name="arrow" /></a></p>
      </div>
      <Cta position="cost" title="費用のことを先に相談したい方へ" lead="「この人数だと総額はいくらか」「今の貯えで収まるか」など、具体的な金額のご相談に無料でお答えします。" telText="電話で費用を相談" contactText="メールで費用を相談" />
    </div>
  </section>

  <!-- 斎場・火葬場 -->
  <section class="section section--alt" aria-labelledby="halls-h">
    <div class="container">
      <div class="article">
        <h2 id="halls-h" class="section-title">町田市の斎場・火葬場</h2>
        <div class="answer"><p>町田市内の公営火葬場は<strong>南多摩斎場</strong>（町田市上小山田町）の1か所です。八王子市・町田市・多摩市・稲城市・日野市の5市で運営し、この5市の住民は火葬料が<strong>無料</strong>、市外の方は12歳以上80,000円です。火葬場に併設の式場（第一〜第三式場）で通夜・告別式まで行えます。</p></div>
        <div class="table-wrap">
          <table>
            <caption>町田市民が利用しやすい火葬場と火葬料（大人1体。公営施設の使用料は非課税。確認日 {SITE.lastReviewed}）</caption>
            <thead><tr><th scope="col">火葬場</th><th scope="col">所在地</th><th scope="col">町田市民の火葬料</th><th scope="col">向いているエリア</th></tr></thead>
            <tbody>
              <tr data-track-view="hall" data-item="南多摩斎場"><th scope="row">南多摩斎場</th><td>町田市上小山田町</td><td class="num"><strong>無料</strong></td><td>市内全域（第一候補）</td></tr>
              <tr data-track-view="hall" data-item="横浜市北部斎場"><th scope="row">横浜市北部斎場</th><td>横浜市緑区長津田町</td><td class="num">50,000円（市外料金）</td><td>南町田・つくし野・成瀬</td></tr>
              <tr data-track-view="hall" data-item="相模原市営斎場"><th scope="row">相模原市営斎場</th><td>相模原市南区古淵</td><td class="num">54,000円（市外料金）</td><td>町田駅周辺・木曽・多摩境</td></tr>
            </tbody>
          </table>
        </div>
        <p>南多摩斎場は友引と1月1日〜3日が休場で、混雑期は火葬まで1週間前後待つこともあります。待つ日数だけ安置費用が増えるため、日程を優先する場合は市外の火葬場も選択肢になります。</p>
        <Source items={[{ label: '南多摩斎場 使用料', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' }, { label: '横浜市 斎場使用料', href: 'https://www.city.yokohama.lg.jp/kurashi/sumai-kurashi/saijo/saijo/saijou.html' }, { label: '相模原市営斎場', href: 'https://www.city.sagamihara.kanagawa.jp/kurashi/shisetsu/shikanren/etc/1002725.html' }]} />
        <div class="link-row">
          <a href="/halls/crematorium/" class="next-link"><span><span class="next-link__label">火葬場</span>南多摩斎場の料金・予約・休場日と、混雑時の代替火葬場</span><Icon name="arrow" /></a>
          <a href="/halls/" class="next-link"><span><span class="next-link__label">式場</span>町田市の斎場・葬儀場一覧（公営・民営・寺院）</span><Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 流れ -->
  <section class="section" aria-labelledby="flow-h">
    <div class="container">
      <div class="article">
        <h2 id="flow-h" class="section-title">亡くなってから葬儀までの流れ</h2>
        <div class="answer"><p>町田市では、亡くなった当日に搬送と安置、翌日以降に死亡届と火葬場の予約・打ち合わせ、その後に通夜・告別式・火葬という流れが一般的です。南多摩斎場の空き状況によって、火葬まで<strong>3日〜1週間程度</strong>かかります。</p></div>
        <ol class="steps">
          <li><span class="steps__t">当日</span><strong>ご逝去・搬送・安置</strong>　病院や施設からご自宅または安置施設へ搬送します。深夜・早朝でも受け付けます。</li>
          <li><span class="steps__t">当日〜翌日</span><strong>打ち合わせ・火葬場の予約</strong>　形式・式場・日程を決め、南多摩斎場などの火葬枠を押さえます。</li>
          <li><span class="steps__t">7日以内</span><strong>死亡届の提出・火葬許可証の受け取り</strong>　町田市役所市民課（1階104窓口）または市民センターへ。通常は葬儀社が代行します。</li>
          <li><span class="steps__t">火葬前日</span><strong>納棺・通夜</strong>（家族葬の場合）　一日葬・火葬式では通夜を行いません。</li>
          <li><span class="steps__t">火葬当日</span><strong>告別式・火葬・収骨</strong>　火葬は約1〜1.5時間。その後、初七日法要を同日に行うこともあります。</li>
        </ol>
        <Source items={[{ label: '町田市 死亡届', href: 'https://www.city.machida.tokyo.jp/kurashi/touroku/todokede/todokede03.html' }]} />
        <div class="link-row">
          <a href="/first-steps/" class="next-link"><span><span class="next-link__label">最初の24時間</span>亡くなってから最初にすること（病院・自宅・施設の場合別）</span><Icon name="arrow" /></a>
          <a href="/flow/" class="next-link"><span><span class="next-link__label">全体の流れ</span>葬儀の流れと手続きの一覧（逝去から法要・各種手続きまで）</span><Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- エリア -->
  <section class="section section--alt" aria-labelledby="area-h">
    <div class="container">
      <h2 id="area-h" class="section-title">町田市内のエリア別案内</h2>
      <p class="section-lead">町田市は南北に長く、お住まいの場所によって近い式場・火葬場が変わります。エリアごとに、最寄りの式場・火葬場・病院と、搬送の目安をまとめています。</p>
      <ul class="area-list">
        {areas.map((a) => (
          <li><a href={a.href}><span class="area-list__label">{a.label}</span><span class="area-list__note">{a.note}</span><Icon name="chevron" /></a></li>
        ))}
      </ul>
      <p class="note"><a href="/machida/">町田市の葬儀ガイド</a>では、市全体の特徴（火葬場が1か所であること、市民葬の現状、費用の目安）をまとめています。</p>
    </div>
  </section>

  <!-- 方針 -->
  <section class="section" aria-labelledby="policy-h">
    <div class="container">
      <h2 id="policy-h" class="section-title">{BRAND.name}の方針</h2>
      <div class="grid grid--3 policies">
        <div class="policy"><h3>追加費用を先に伝える</h3><p>プラン料金に「含まれないもの」を先に説明し、式場使用料・安置日数・返礼品など変動する費用は見積もりで金額を明示します。</p></div>
        <div class="policy"><h3>出典と確認日を示す</h3><p>火葬場の料金や葬祭費などの制度は、町田市・南多摩斎場組合などの公式情報を確認し、出典と最終確認日を掲載しています。</p></div>
        <div class="policy"><h3>急がせない</h3><p>搬送だけのご依頼でも構いません。安置後に葬儀の内容を落ち着いて決めていただき、他社と比較していただいても結構です。</p></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt" aria-labelledby="faq-h">
    <div class="container">
