---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Source from '../components/Source.astro';
import MachidaMap from '../components/MachidaMap.astro';
import PlanPictogram from '../components/PlanPictogram.astro';
import CostBar from '../components/CostBar.astro';
import Photo from '../components/Photo.astro';
import { getImage } from 'astro:assets';
import heroPhoto from '../assets/photos/hero-lisianthus.jpg';
import photoKazokuso from '../assets/photos/candles-flowers.jpg';
import photoIchinichiso from '../assets/photos/mums-white-bg.jpg';
import photoKasoshiki from '../assets/photos/mums-bunch.jpg';
import { BRAND, PHONE, SITE } from '../config/site';

const title = '町田市の葬儀・家族葬｜費用・斎場・手続きを分かりやすく案内｜町田ことのは葬祭';
const description = '町田市の家族葬・一日葬・火葬式（直葬）の費用と流れ、南多摩斎場など町田市で使える斎場・火葬場、葬祭費5万円の申請まで、出典付きで分かりやすく解説。深夜・早朝のご相談にも対応します。';

const plans = [
  { slug: 'kazokuso', name: '家族葬', price: '528,000', days: '2日', people: '10〜30名', desc: '通夜と告別式を2日間で行う、家族・親族中心の葬儀。', who: '家族だけでゆっくり送りたい方', fit: 'ゆっくりお別れしたい方に', key: 'kazokuso' as const },
  { slug: 'ichinichiso', name: '一日葬', price: '396,000', days: '1日', people: '5〜20名', desc: '通夜を省き、告別式と火葬を1日で行う葬儀。', who: '一日で葬儀を済ませたい方', fit: '参列者の負担を軽くしたい方に', key: 'ichinichiso' as const },
  { slug: 'kasoshiki', name: '火葬式・直葬', price: '198,000', days: '火葬のみ', people: '1〜10名', desc: '式を行わず、安置後に火葬場でお別れをする最もシンプルな形式。', who: '火葬だけを希望する方・費用を抑えたい方', fit: '費用を抑えたい方に', key: 'kasoshiki' as const },
];

const planPhotos = { kazokuso: photoKazokuso, ichinichiso: photoIchinichiso, kasoshiki: photoKasoshiki } as const;
const planPhotoAlt = { kazokuso: '家族葬のイメージ。ろうそくの明かりと白い花', ichinichiso: '一日葬のイメージ。白い菊の花', kasoshiki: '火葬式のイメージ。白い菊の花束' } as const;

const heroSizes = '(min-width: 1024px) 100vw, 100vw';
const heroWidths = [640, 960, 1366, 1800];
const heroAvif = await getImage({ src: heroPhoto, widths: heroWidths, format: 'avif', quality: 55 });
const heroPreload = { srcset: heroAvif.srcSet.attribute, sizes: heroSizes, type: 'image/avif' };

const needs = [
  { need: '家族だけでゆっくり送りたい', to: '家族葬', sub: '528,000円〜', href: '/plans/kazokuso/' },
  { need: '一日で葬儀を済ませたい', to: '一日葬', sub: '396,000円〜', href: '/plans/ichinichiso/' },
  { need: '火葬だけを希望している', to: '火葬式・直葬', sub: '198,000円〜', href: '/plans/kasoshiki/' },
  { need: '費用をできるだけ抑えたい', to: '費用の目安と抑え方', sub: '総額約25万円〜', href: '/cost/' },
  { need: '公営の斎場を使いたい', to: '南多摩斎場', sub: '町田市民は火葬料無料', href: '/halls/crematorium/' },
  { need: 'まだ何も決まっていない', to: '最初にすること', sub: '搬送だけの依頼も可', href: '/first-steps/' },
];

const costRows = [
  { name: '火葬式・直葬', note: 'お布施別', href: '/plans/kasoshiki/', segs: [{ label: 'プラン料金', value: 198000 }, { label: '式場使用料', value: 0 }, { label: '飲食・返礼品', value: 0 }], total: '約20〜25万円' },
  { name: '一日葬（10名）', note: 'お布施別', href: '/plans/ichinichiso/', segs: [{ label: 'プラン料金', value: 396000 }, { label: '式場使用料', value: 50000 }, { label: '飲食・返礼品', value: 70000 }], total: '約50〜65万円' },
  { name: '家族葬（20名）', note: 'お布施別', href: '/plans/kazokuso/', segs: [{ label: 'プラン料金', value: 528000 }, { label: '式場使用料', value: 50000 }, { label: '飲食・返礼品', value: 240000 }], total: '約75〜95万円' },
];

const faqs = [
  { q: '町田市で亡くなった場合、最初に何をすればいいですか？', a: '<p>まず葬儀社に連絡して、ご遺体の搬送と安置先を決めます。病院で亡くなった場合、数時間以内に霊安室から移動を求められることが多いためです。葬儀の形式や式場は搬送後に落ち着いて決めて構いません。死亡届は亡くなったことを知った日から7日以内に町田市役所市民課などへ提出します。詳しくは<a href="/first-steps/">亡くなってから最初にすること</a>をご覧ください。</p>' },
  { q: '町田市の家族葬はいくらくらいですか？', a: '<p>当サイトの家族葬プランは528,000円（税込）からで、式場使用料・飲食・返礼品・宗教者へのお礼は別途です。南多摩斎場を利用する町田市民は火葬料が無料のため、火葬場の費用を抑えられます。参列人数別の総額例は<a href="/cost/">葬儀費用</a>のページで解説しています。</p>' },
  { q: '町田市で利用できる火葬場はどこですか？', a: '<p>町田市内の公営火葬場は南多摩斎場（町田市上小山田町）の1か所です。町田市を含む組織5市の住民は火葬料が無料です。混雑時は横浜市北部斎場や相模原市営斎場など市外の火葬場も利用できますが、市外料金がかかります。<a href="/halls/crematorium/">町田市の火葬場</a>で料金と使い分けを説明しています。</p>' },
  { q: '葬祭費は受け取れますか？', a: '<p>故人が町田市の国民健康保険または後期高齢者医療制度に加入していた場合、葬儀を行った喪主に葬祭費50,000円が支給されます。申請期限は葬儀の翌日から2年です。会社の健康保険に加入していた場合は、健康保険から埋葬料が支給されます。<a href="/subsidy/">葬祭費・補助金</a>で申請方法を確認できます。</p>' },
  { q: '病院からすぐに葬儀社を決める必要がありますか？', a: '<p>搬送と安置を依頼する葬儀社は急いで決める必要がありますが、葬儀そのものを同じ葬儀社に頼む義務はありません。搬送だけを依頼し、安置後に葬儀の内容と依頼先を検討することができます。当サイトでも搬送のみのご依頼をお受けしています。</p>' },
];

const areas = [
  { href: '/area/machida-eki/', label: '町田駅周辺', note: '原町田・森野・中町・木曽・忠生' },
  { href: '/area/tsurukawa/', label: '鶴川・玉川学園前', note: '能ヶ谷・金井・薬師台・三輪' },
  { href: '/area/naruse/', label: '成瀬・高ヶ坂', note: '成瀬台・南成瀬・西成瀬' },
  { href: '/area/minami-machida/', label: '南町田・つくし野・すずかけ台', note: '鶴間・金森・小川' },
  { href: '/area/tamasakai-aihara/', label: '多摩境・相原・小山', note: '小山ヶ丘・相原町・小山町' },
];
---
<BaseLayout title={title} description={description} pageType="top" fixedCta={{ contactText: '費用を相談' }} preloadImage={heroPreload}>
  <!-- ===== ファーストビュー ===== -->
  <section class="fv" data-region="hero" aria-labelledby="hero-h">
    <div class="fv__bg">
      <Photo src={heroPhoto} alt="白い花と柔らかい光。落ち着いたお別れのイメージ" widths={heroWidths} sizes={heroSizes} priority class="fv__photo" quality={55} />
    </div>
    <div class="container fv__inner">
      <div class="fv__copy">
        <p class="fv__area"><Icon name="pin" size={18} />東京都町田市の家族葬・一日葬・火葬式</p>
        <h1 id="hero-h">突然のことでも、<br />お電話一本で大丈夫です。</h1>
        <p class="fv__sub">町田市の家族葬・一日葬・火葬式を承る葬儀社サイトです。夜間・早朝でも、病院や施設へのお迎え（搬送）からお受けします。</p>
        <ul class="fv__promises" aria-label="安心してご相談いただくために">
          <li><Icon name="check" size={22} strokeWidth={2.5} /><span>葬儀が初めてでも、<strong>一つずつご案内します</strong></span></li>
          <li><Icon name="check" size={22} strokeWidth={2.5} /><span>費用は先にご説明します。<strong>分からないまま進めることはありません</strong></span></li>
          <li><Icon name="check" size={22} strokeWidth={2.5} /><span>お迎え（搬送）だけのご依頼もできます。<strong>葬儀社はあとで決めても構いません</strong></span></li>
        </ul>
        <div class="fv__cta">
          <a href={PHONE.tel} class="fv__tel" data-cta="tel" data-cta-position="hero" data-cta-text="電話で相談する">
            <span class="fv__tel-label"><Icon name="phone-call" size={22} />電話で相談する</span>
            <span class="fv__tel-num num">{PHONE.display}</span>
            <span class="fv__tel-note">24時間365日受付・ご相談は無料</span>
          </a>
          <a href="/cost/" class="fv__second" data-cta="cta" data-cta-position="hero"><Icon name="doc" size={22} />費用の目安を見る</a>
        </div>
        <p class="fv__links">
          <a href="/first-steps/"><Icon name="alarm" size={18} />病院から急かされている方へ：最初にすること</a>
          <a href="/contact/" data-cta="contact" data-cta-position="hero" data-cta-text="事前のご相談・お見積もり"><Icon name="mail" size={18} />事前のご相談・お見積もり</a>
        </p>
        <p class="fv__dummy">{PHONE.note}</p>
      </div>
    </div>
    <div class="container">
      <ol class="fv__steps" aria-label="ご連絡から葬儀までの流れ">
        <li><span class="fv__step-n">1</span><span class="fv__step-body"><span class="fv__step-t">お電話</span><span class="fv__step-d">状況をお聞きし、お迎えの手配をします</span></span></li>
        <li><span class="fv__step-n">2</span><span class="fv__step-body"><span class="fv__step-t">お迎え・安置</span><span class="fv__step-d">ご自宅または安置施設へお連れします</span></span></li>
        <li><span class="fv__step-n">3</span><span class="fv__step-body"><span class="fv__step-t">落ち着いてから、葬儀を決める</span><span class="fv__step-d">形式・費用・斎場をご説明してから決めていただきます</span></span></li>
      </ol>
    </div>
  </section>

  <!-- ===== ご希望から選ぶ ===== -->
  <section class="section section--needs" aria-labelledby="needs-h">
    <div class="container">
      <h2 id="needs-h" class="section-title">ご希望から選ぶ</h2>
      <ul class="needs" aria-label="ご希望に合う葬儀の形式・ページ">
        {needs.map((n) => (
          <li><a href={n.href} class="need"><span class="need__q">{n.need}</span><span class="need__to"><Icon name="arrow" />{n.to}<span class="need__sub">{n.sub}</span></span></a></li>
        ))}
      </ul>
      <p class="hero__areas"><span class="hero__areas-k">対応エリア</span>{areas.map((a, i) => <span>{i > 0 && '・'}<a href={a.href}>{a.label}</a></span>)}<span>　ほか町田市全域</span></p>
    </div>
  </section>

  <!-- ===== 状況から選ぶ ===== -->
  <section class="section" aria-labelledby="start-h">
    <div class="container">
      <h2 id="start-h" class="section-title">今の状況に合わせて選ぶ</h2>
      <ul class="starts">
        <li>
          <a href="/first-steps/" class="start">
            <span class="start__label start__label--urgent">今すぐ</span>
            <span class="start__title">すでに亡くなった・危篤と言われた</span>
            <span class="start__desc">搬送先と安置の決め方、死亡届、最初の24時間ですること。</span>
            <Icon name="chevron" />
          </a>
          <a href={PHONE.tel} class="start__cta" data-cta="tel" data-cta-position="middle" data-cta-text="今すぐ搬送について相談"><Icon name="phone" />今すぐ搬送について相談</a>
        </li>
        <li>
          <a href="/cost/" class="start">
            <span class="start__label">費用を知りたい</span>
            <span class="start__title">町田市の葬儀費用と総額の目安</span>
            <span class="start__desc">形式別・人数別の総額例、追加になりやすい費用、安く抑える方法。</span>
            <Icon name="chevron" />
          </a>
          <a href={PHONE.tel} class="start__cta" data-cta="tel" data-cta-position="middle" data-cta-text="葬儀費用について相談"><Icon name="phone" />葬儀費用について相談</a>
        </li>
        <li>
          <a href="/plans/" class="start">
            <span class="start__label">事前に備えたい</span>
            <span class="start__title">葬儀の形式を比べて決めておく</span>
            <span class="start__desc">家族葬・一日葬・火葬式の違いと向き不向き。事前相談も受け付けています。</span>
            <Icon name="chevron" />
          </a>
          <a href="/contact/" class="start__cta" data-cta="contact" data-cta-position="middle" data-cta-text="自分に合うプランを相談"><Icon name="mail" />自分に合うプランを相談</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ===== プラン ===== -->
  <section class="section section--alt" aria-labelledby="plans-h">
    <div class="container">
      <h2 id="plans-h" class="section-title">ご希望に合わせて選べる、3つの葬儀プラン</h2>
      <p class="section-lead">違いは「通夜と告別式を行うか」だけです。プラン料金には、町田市内の搬送・2日間の安置・棺・ドライアイス・骨壺・火葬場の手続き・当日の進行が含まれます。式場使用料、火葬料（南多摩斎場は町田市民無料）、飲食・返礼品、宗教者へのお礼は別途です。</p>
      <div class="grid grid--3">
        {plans.map((p) => (
          <article class="plan" data-track-view="plan" data-item={p.name} data-region="plan">
            <div class="plan__visual"><Photo src={planPhotos[p.key]} alt={planPhotoAlt[p.key]} widths={[480, 800]} sizes="(min-width: 768px) 360px, 100vw" ratio="3/2" /><span class="plan__who">{p.who}</span></div>
            <h3 class="plan__name"><a href={`/plans/${p.slug}/`}>{p.name}</a></h3>
            <PlanPictogram plan={p.key} size="sm" />
            <p class="plan__price"><span class="num">{p.price}</span><span class="plan__unit">円（税込）〜</span></p>
            <dl class="plan__spec">
              <div><dt>日数</dt><dd>{p.days}</dd></div>
              <div><dt>参列</dt><dd>{p.people}</dd></div>
              <div><dt>式場</dt><dd>{p.key === 'kasoshiki' ? '不要' : '必要'}</dd></div>
            </dl>
            <p class="plan__desc">{p.desc}<strong>{p.fit}</strong>。</p>
            <a href={`/plans/${p.slug}/`} class="plan__link">{p.name}の内容と費用を見る<Icon name="chevron" /></a>
          </article>
        ))}
      </div>
      <p class="note" style="margin-top:1rem">料金は本サイト（検証用）の設定価格です。<a href="/plans/">3つの形式の比較と、自分に合う形式の選び方</a>で、日程・参列人数・向いている方の違いを確認できます。</p>
    </div>
  </section>

  <!-- ===== 費用 ===== -->
  <section class="section" aria-labelledby="cost-h">
    <div class="container">
      <div class="article two-col">
        <div>
          <h2 id="cost-h" class="section-title">町田市で葬儀をすると、総額はいくらかかる？</h2>
          <div class="answer"><p>町田市で南多摩斎場を利用する場合、火葬式で<strong>約25万円</strong>、一日葬で<strong>約50〜65万円</strong>、家族葬（20名）で<strong>約75〜95万円</strong>が総額の目安です。差が出るのは、式場使用料・参列人数に応じた飲食と返礼品・宗教者へのお礼の3つです。</p></div>
          <p class="note">試算の前提：町田市民が南多摩斎場の第二・第三式場（組織市住民50,000円）を使い、火葬料は無料。飲食は1人1食5,000円、返礼品は1人2,000円。宗教者へのお礼は含みません。故人が国保・後期高齢者医療の加入者なら、葬祭費50,000円が後日支給されます。</p>
          <Source items={[{ label: '南多摩斎場 使用料', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' }, { label: '町田市 葬祭費', href: 'https://www.city.machida.tokyo.jp/kurashi/hoken/kokuho/ironnakyuufu/sousai.html' }]} />
        </div>
        <div>
          <CostBar rows={costRows} max={818000} />
          <a href="/cost/" class="next-link"><span><span class="next-link__label">くわしく見る</span>葬儀費用の内訳・人数別の総額例・安く抑える方法</span><Icon name="arrow" /></a>
        </div>
      </div>
      <Cta position="cost" title="費用のことを先に相談したい方へ" lead="「この人数だと総額はいくらか」「今の貯えで収まるか」など、具体的な金額のご相談に無料でお答えします。" telText="電話で費用を相談" contactText="メールで費用を相談" />
    </div>
  </section>

  <!-- ===== 斎場・火葬場 ===== -->
  <section class="section section--alt" aria-labelledby="halls-h">
    <div class="container">
      <div class="article two-col two-col--rev">
        <div>
          <h2 id="halls-h" class="section-title">町田市の斎場・火葬場</h2>
          <div class="answer"><p>町田市内の公営火葬場は<strong>南多摩斎場</strong>（町田市上小山田町）の1か所です。八王子市・町田市・多摩市・稲城市・日野市の5市で運営し、この5市の住民は火葬料が<strong>無料</strong>、市外の方は12歳以上80,000円です。火葬場に併設の式場（第一〜第三式場）で通夜・告別式まで行えます。</p></div>
          <ul class="hall-list">
            <li data-track-view="hall" data-item="南多摩斎場"><span class="hall-list__name">南多摩斎場</span><span class="hall-list__place">町田市上小山田町</span><span class="hall-list__fee"><strong>無料</strong></span><span class="hall-list__fit">市内全域の第一候補</span></li>
            <li data-track-view="hall" data-item="横浜市北部斎場"><span class="hall-list__name">横浜市北部斎場</span><span class="hall-list__place">横浜市緑区長津田町</span><span class="hall-list__fee">50,000円<small>（市外料金）</small></span><span class="hall-list__fit">南町田・つくし野・成瀬</span></li>
            <li data-track-view="hall" data-item="相模原市営斎場"><span class="hall-list__name">相模原市営斎場</span><span class="hall-list__place">相模原市南区古淵</span><span class="hall-list__fee">54,000円<small>（市外料金）</small></span><span class="hall-list__fit">町田駅周辺・木曽・多摩境</span></li>
          </ul>
          <p class="note">火葬料は大人1体・町田市民の場合。公営施設の使用料は非課税。確認日 {SITE.lastReviewed}。南多摩斎場は友引と1月1日〜3日が休場で、混雑期は火葬まで1週間前後待つこともあります。</p>
          <Source items={[{ label: '南多摩斎場 使用料', href: 'https://www.minamitama-saijyo.jp/guide/charge.php' }, { label: '横浜市 斎場使用料', href: 'https://www.city.yokohama.lg.jp/kurashi/sumai-kurashi/saijo/saijo/saijou.html' }, { label: '相模原市営斎場', href: 'https://www.city.sagamihara.kanagawa.jp/kurashi/shisetsu/shikanren/etc/1002725.html' }]} />
        </div>
        <div>
