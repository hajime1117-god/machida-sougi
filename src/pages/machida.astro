const related = [
  { href: '/halls/crematorium/', label: '町田市の火葬場', note: '南多摩斎場の料金・予約・市外火葬場との比較' },
  { href: '/halls/', label: '町田市の斎場・葬儀場', note: '公営・民営・寺院の式場一覧' },
