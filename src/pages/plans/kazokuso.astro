const description = '町田市で家族葬を行う場合の費用（プラン528,000円〜、20名で総額約75〜95万円）、南多摩斎場や民営ホールなど使える式場、2日間の流れ、参列を断る方への連絡や菩提寺との調整など注意点を、町田市の事情に合わせて解説します。';
const toc = [
  { id: 'toha', label: '家族葬とは' },
  { id: 'hiyou', label: '町田市の家族葬の費用' },
  { id: 'plan', label: '家族葬プランの内容' },
