const related = [
  { href: '/cost/', label: '葬儀費用の内訳と総額例', note: '追加になりやすい費用と安く抑える方法' },
  { href: '/halls/', label: '町田市の斎場・葬儀場', note: '南多摩斎場の式場と民営式場' },
  { href: '/halls/crematorium/', label: '町田市の火葬場', note: '南多摩斎場の料金・予約・混雑時の代替' },
